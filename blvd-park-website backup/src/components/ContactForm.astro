---
// src/components/ContactForm.astro
---

<form class="space-y-6 p-6 bg-white rounded-lg shadow-md border border-blvd-light-green text-center">
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="first-name" class="block mb-2 text-sm font-medium text-blvd-green text-center">First Name</label>
      <input
        type="text"
        id="first-name"
        class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3"
        placeholder="Your first name"
        required
      >
    </div>
    
    <div>
      <label for="last-name" class="block mb-2 text-sm font-medium text-blvd-green text-center">Last Name</label>
      <input
        type="text"
        id="last-name"
        class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3 text-center"
        placeholder="Your last name"
        required
      >
    </div>
  </div>
  
  <div>
    <label for="email" class="block mb-2 text-sm font-medium text-blvd-green text-center">Email</label>
    <input
      type="email"
      id="email"
      class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3 text-center"
      placeholder="your.email@example.com"
      required
    >
  </div>
  
  <div>
    <label for="phone" class="block mb-2 text-sm font-medium text-blvd-green text-center">Mobile Phone</label>
    <input
      type="tel"
      id="phone"
      class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3 text-center"
      placeholder="(123) 456-7890"
      required
    >
  </div>
  
  <div>
    <label for="message" class="block mb-2 text-sm font-medium text-blvd-green text-center">Message</label>
    <textarea
      id="message"
      rows="4"
      class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3 text-center"
      placeholder="Your message here..."
      required
    ></textarea>
  </div>
  
  <div class="bg-blvd-light-green/20 p-4 rounded-lg">
    <label for="captcha" class="block mb-2 text-sm font-medium text-blvd-green text-center">You're not a bot are you? What's ten minus 7?</label>
    <input
      type="text"
      id="captcha"
      class="bg-blvd-white border border-blvd-light-green text-blvd-green text-sm rounded-lg focus:ring-blvd-green focus:border-blvd-green block w-full p-3 text-center"
      required
    >
  </div>
  
  
  <button
    type="submit"
    class="w-full text-blvd-white bg-blvd-green hover:bg-blvd-accent hover:text-blvd-green focus:ring-4 focus:ring-blvd-light-green font-medium rounded-lg text-sm px-5 py-3 text-center transition-colors"
  >
    Submit
  </button>
</form>

<script>
  // Simple form validation for demo purposes
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('form');
    const captchaInput = document.getElementById('captcha');
    
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Captcha validation - accept both "3" and "three" as valid answers
        const captchaValue = captchaInput ? captchaInput.value.trim().toLowerCase() : '';
        if (captchaInput && (captchaValue === '3' || captchaValue === 'three')) {
          alert('Thank you for your message! We will get back to you soon.');
          form.reset();
        } else {
          alert('Please answer the captcha question correctly (3 or three).');
        }
      });
    }
  });
</script>
