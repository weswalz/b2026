---
// No InstagramFeed import needed
const { type, url } = Astro.props;
---

<section class="py-16 bg-circle-pattern bg-blvd-white">
  <div class="max-w-screen-xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-blvd-green">Experience BLVD Park</h2>
    
    <div class="flex justify-center max-w-3xl mx-auto">
      {type === 'instagram' && (
        <div class="w-full flex justify-center">
          <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/blvdparkhtx/?utm_source=ig_embed&amp;utm_campaign=loading" data-instgrm-version="14" style=" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:540px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);">
            <!-- Instagram embed code -->
          </blockquote>
          <script async src="//www.instagram.com/embed.js"></script>
        </div>
      )}
      
      {!type && !url && (
        <div class="instagram-container" style="max-width:540px; width:100%; margin:0 auto; border-radius:4px; overflow:hidden; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15);">
          <a href="https://www.instagram.com/blvdparkhtx/" target="_blank" rel="noopener noreferrer" class="block">
            <img
              src="/images/blvdherobg.jpg"
              alt="BLVD Park Instagram Profile"
              class="w-full h-auto"
            />
            <div class="p-4 bg-white text-center">
              <h3 class="font-bold text-lg mb-2">BLVD Park Houston</h3>
              <p class="text-gray-600">Follow us on Instagram @blvdparkhtx</p>
              <div class="mt-4 inline-block bg-blvd-green text-white px-4 py-2 rounded-md">View Profile</div>
            </div>
          </a>
        </div>
      )}

      {type === 'tiktok' && url && (
        <div>
          <blockquote class="tiktok-embed" cite={url}>
            <a href={url}></a>
          </blockquote>
          <script async src="https://www.tiktok.com/embed.js"></script>
        </div>
      )}
    </div>
  </div>
</section>
