---
// src/components/GalleryGrid.astro
interface Props {
  images: {
    src: string;
    alt: string;
  }[];
  columns: number;
  gap?: string;
}

const { images, columns, gap = "gap-4" } = Astro.props;

// Calculate responsive column classes based on the requested columns
const getColumnClasses = (cols) => {
  switch (cols) {
    case 3: return "grid-cols-1 sm:grid-cols-2 md:grid-cols-3";
    case 4: return "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4";
    case 5: return "grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5";
    case 6: return "grid-cols-1 sm:grid-cols-3 lg:grid-cols-6";
    default: return `grid-cols-1 sm:grid-cols-2 md:grid-cols-${Math.min(cols, 4)} lg:grid-cols-${cols}`;
  }
};

const columnClasses = getColumnClasses(columns);
---

<div class={`grid ${columnClasses} ${gap}`}>
  {images.map((image, index) => (
    <div class="overflow-hidden rounded-lg aspect-square">
      <img
        src={image.src}
        alt={image.alt}
        class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-110"
        loading={index < 8 ? "eager" : "lazy"}
      />
    </div>
  ))}
</div>
