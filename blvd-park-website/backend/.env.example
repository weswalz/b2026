PORT=3001
ADMIN_API_KEY=change-this-to-a-secure-random-key
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:4321

# Email (optional)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=noreply@blvdpark.com

# IndexNow (optional) — 8-128 hex chars; must also be set for the frontend process
# (INDEXNOW_KEY, not PUBLIC_-prefixed — it's read server-side only via process.env in
# src/pages/[key].txt.ts). Leave unset to disable IndexNow pings entirely.
INDEXNOW_KEY=
