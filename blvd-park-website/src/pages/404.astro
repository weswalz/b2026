---
export const prerender = true;
// 404 Page - Not Found
import Layout2026 from '@layouts/Layout2026.astro';

const title = "Page Not Found | BLVD Park";
const description = "The page you're looking for doesn't exist.";
---

<Layout2026 title={title} description={description}>
  <section class="min-h-[80vh] flex items-center justify-center bg-dark-base relative overflow-hidden">
    <!-- Ambient orb -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[400px] h-[400px] rounded-full opacity-10 blur-[120px] bg-blvd-green"></div>

    <div class="relative z-10 text-center px-6 max-w-lg mx-auto">
      <span class="eyebrow inline-block mb-6">404</span>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-4 tracking-tight">
        Page Not Found
      </h1>
      <p class="font-body text-lg text-white/50 mb-10 max-w-md mx-auto">
        Looks like this page took a wrong turn. Let's get you back to the action.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-sm transition-all duration-300 hover:scale-105 bg-blvd-green text-white hover:bg-blvd-green-bright"
        >
          Back to Home
        </a>
        <a
          href="/menu"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-sm transition-all duration-300 hover:scale-105 bg-white/5 text-white border border-white/10 hover:bg-white/10"
        >
          View Menu
        </a>
      </div>
    </div>
  </section>
</Layout2026>
