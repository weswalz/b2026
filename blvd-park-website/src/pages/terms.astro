---
// src/pages/terms.astro - Terms of Service Page
import Layout2026 from '@layouts/Layout2026.astro';
---

<Layout2026 title="Terms of Service | BLVD Park" description="Terms of Service for BLVD Park">

  <section class="relative pt-32 pb-20 overflow-hidden" style="background: linear-gradient(180deg, #0F3D22 0%, #1a1a1a 100%);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.65%27 numOctaves=%273%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl">
        <a href="/2026" class="inline-flex items-center gap-2 text-white/50 hover:text-white transition-colors mb-8 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Home
        </a>

        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6" style="font-family: 'Clash Display', sans-serif; letter-spacing: -0.02em;">
          Terms of Service
        </h1>
        <p class="text-xl text-white/60" style="font-family: 'Satoshi', sans-serif;">
          Last updated: January 2026
        </p>
      </div>
    </div>
  </section>

  <section class="py-20" style="background: #0d0d0d;">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto prose prose-invert prose-lg" style="color: rgba(255,255,255,0.7);">

        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Clash Display', sans-serif;">Acceptance of Terms</h2>
        <p>By accessing and using the BLVD Park website and services, you accept and agree to be bound by these Terms of Service.</p>

        <h2 class="text-2xl font-bold text-white mb-4 mt-10" style="font-family: 'Clash Display', sans-serif;">Use of Services</h2>
        <p>Our services include table reservations, event bookings, and access to our facilities. You agree to use these services responsibly and in compliance with all applicable laws.</p>

        <h2 class="text-2xl font-bold text-white mb-4 mt-10" style="font-family: 'Clash Display', sans-serif;">Reservations & Cancellations</h2>
        <p>Reservations are subject to availability. We reserve the right to cancel or modify reservations with reasonable notice. For large party bookings, please contact us directly for our cancellation policy.</p>

        <h2 class="text-2xl font-bold text-white mb-4 mt-10" style="font-family: 'Clash Display', sans-serif;">Venue Rules</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Guests must be 21+ to consume alcohol</li>
          <li>Appropriate attire required</li>
          <li>Management reserves the right to refuse service</li>
          <li>Pickleball courts are first-come, first-served</li>
        </ul>

        <h2 class="text-2xl font-bold text-white mb-4 mt-10" style="font-family: 'Clash Display', sans-serif;">Limitation of Liability</h2>
        <p>BLVD Park shall not be liable for any indirect, incidental, or consequential damages arising from your use of our services or facilities.</p>

        <h2 class="text-2xl font-bold text-white mb-4 mt-10" style="font-family: 'Clash Display', sans-serif;">Contact Us</h2>
        <p>For questions about these Terms, please contact us at:</p>
        <p>
          BLVD Park<br/>
          1119 W 20th Street<br/>
          Houston, TX 77008
        </p>

      </div>
    </div>
  </section>

</Layout2026>
