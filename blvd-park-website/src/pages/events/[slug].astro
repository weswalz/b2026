---
// Event detail route — SSR only (no prerender). Active, non-deleted events render with
// full SEO head + auto-generated Event JSON-LD (https://schema.org/Event); missing/deleted
// slugs 404. Data comes from blvdpark-api. Pattern mirrors src/pages/[slug].astro (CMS pages).
import Layout2026 from "@layouts/Layout2026.astro";

const { slug } = Astro.params;
const INTERNAL_API = process.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || "https://blvdpark.com";

let event: any = null;
if (slug && /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) {
  try {
    const res = await fetch(`${INTERNAL_API}/api/events/public/${slug}`);
    if (res.ok) event = await res.json();
  } catch (_e) {
    // API unreachable — treat as not found
  }
}

if (!event) Astro.response.status = 404;

let jsonLdSafe = "";
if (event) {
  const startDateTime = event.time ? `${event.date}T${event.time}:00` : event.date;
  const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Event",
    name: event.title,
    startDate: startDateTime,
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus:
      event.status === "cancelled"
        ? "https://schema.org/EventCancelled"
        : "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: "BLVD Park",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1119 W 20th Street",
        addressLocality: "Houston",
        addressRegion: "TX",
        postalCode: "77008",
        addressCountry: "US",
      },
    },
    ...(event.description ? { description: event.description } : {}),
    ...(event.image ? { image: [`https://blvdpark.com${event.image}`] } : {}),
    ...(event.ticketUrl ? { url: event.ticketUrl } : {}),
  };
  jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
}

const ogImage = event ? (event.ogImage || event.image || undefined) : undefined;
---

{
  event ? (
    <Layout2026
      title={event.seoTitle || event.ogTitle || `${event.title} | BLVD Park`}
      description={event.seoDescription || event.ogDescription || event.description || undefined}
      image={ogImage}
      keywords={event.seoKeywords || undefined}
      robots="index, follow"
      canonicalLink={`https://blvdpark.com/events/${event.slug}`}
      canonicalURL={`https://blvdpark.com/events/${event.slug}`}
      jsonLd={jsonLdSafe}
    >
      <section class="section-padding">
        <div style="max-width: 72rem; margin: 0 auto; padding: 0 1.5rem;">
          <p class="eyebrow" style="margin-bottom: 1rem;">{event.category.replace('-', ' ')}</p>
          <h1 class="font-display text-display-md" style="margin-bottom: 1rem;">
            {event.title}
          </h1>
          <p style="font-size: 1.125rem; color: var(--blvd-green); margin-bottom: 2rem;">
            {new Date(`${event.date}T00:00:00`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })} at {event.time}
          </p>
          {event.image && (
            <img
              src={event.image}
              alt={event.title}
              style="width: 100%; max-height: 32rem; object-fit: cover; border-radius: 1rem; margin-bottom: 2rem;"
            />
          )}
          {event.description && (
            <p style="white-space: pre-wrap; font-size: 1.0625rem; line-height: 1.7;">{event.description}</p>
          )}
          {event.ticketUrl && (
            <a
              href={event.ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body"
              style="display: inline-block; margin-top: 2rem; padding: 0.875rem 2rem; background: var(--blvd-green); color: white; border-radius: 0.5rem; text-decoration: none; font-weight: 600;"
            >
              Get Tickets
            </a>
          )}
        </div>
      </section>
    </Layout2026>
  ) : (
    <Layout2026 title="Event Not Found | BLVD Park" description="This event does not exist." robots="noindex, nofollow">
      <section class="section-padding" style="text-align: center;">
        <h1 class="font-display text-display-md">Event Not Found</h1>
        <p style="margin-top: 1.5rem;">
          <a href="/#events" style="color: var(--blvd-green);">Back to events</a>
        </p>
      </section>
    </Layout2026>
  )
}
