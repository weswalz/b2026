---
// src/pages/2026.astro - Preview page for 2026 redesign
// Full premium redesign with all updated sections

import Layout2026 from '@layouts/Layout2026.astro';
import Hero2026 from '@components/Hero2026.astro';
import ValueProps2026 from '@components/ValueProps2026.astro';
import SpecialsSection2026 from '@components/SpecialsSection2026.astro';
import About2026 from '@components/About2026.astro';
import Gallery2026 from '@components/Gallery2026.astro';
import MenuSection2026 from '@components/MenuSection2026.astro';
import VibeSection2026 from '@components/VibeSection2026.astro';
import PickleballSection2026 from '@components/PickleballSection2026.astro';
import EventsSection2026 from '@components/EventsSection2026.astro';
import LocationSection2026 from '@components/LocationSection2026.astro';

const title = "BLVD Park | The Heights' Playground";
const description = "The Heights' premier sports bar with free pickleball courts. Craft cocktails, game day vibes, and a vibrant atmosphere.";
---

<Layout2026 title={title} description={description}>
  <!-- 2026 Hero -->
  <Hero2026 />
  
  <!-- Value Props Strip -->
  <ValueProps2026 />

  <!-- Daily Specials -->
  <SpecialsSection2026 />
  
  <!-- About Section -->
  <About2026 />
  
  <!-- New Gallery -->
  <Gallery2026 />
  
  <!-- 2026 Menu Section -->
  <MenuSection2026 />

  <!-- Social Proof + Vibe -->
  <VibeSection2026 />

  <!-- 2026 Pickleball Section -->
  <PickleballSection2026 />
  
  <!-- 2026 Events Section -->
  <EventsSection2026 />
  
  <!-- 2026 Location Section -->
  <LocationSection2026 />
</Layout2026>
