---
// CMS page route — SSR only (no prerender). Published pages render with full SEO head;
// drafts and unknown slugs 404. Data comes from blvdpark-api.
import Layout2026 from "@layouts/Layout2026.astro";

const { slug } = Astro.params;
const INTERNAL_API = process.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || "https://blvdpark.com";

let page: any = null;
if (slug && /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) {
  try {
    const res = await fetch(`${INTERNAL_API}/api/pages/public/${slug}`);
    if (res.ok) page = await res.json();
  } catch (_e) {
    // API unreachable — treat as not found
  }
}

if (!page) Astro.response.status = 404;

let sections: { type: string; body: string }[] = [];
let faqItems: { question: string; answer: string }[] = [];
let jsonLdSafe = "";
let faqJsonLdSafe = "";
if (page) {
  try {
    sections = JSON.parse(page.content_sections || "[]");
  } catch (_e) {}
  try {
    faqItems = JSON.parse(page.faq_items || "[]");
  } catch (_e) {}
  if (page.json_ld) {
    try {
      jsonLdSafe = JSON.stringify(JSON.parse(page.json_ld)).replace(/</g, "\\u003c");
    } catch (_e) {}
  }
  // Auto FAQPage JSON-LD (https://schema.org/FAQPage, https://schema.org/Question) —
  // kept separate from the manual json_ld field per the shared Pages contract. Note:
  // Google deprecated FAQ rich results in Search as of May 2026, but the schema.org
  // vocabulary itself is still valid and may be consumed by other engines/crawlers.
  if (faqItems.length > 0) {
    const faqSchema = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    };
    faqJsonLdSafe = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
  }
}
---

{
  page ? (
    <Layout2026
      title={page.seo_title || page.title}
      description={page.seo_description || page.description || undefined}
      image={page.og_image || undefined}
      keywords={page.seo_keywords || undefined}
      robots={page.robots}
      canonicalLink={`https://blvdpark.com/${page.slug}`}
      canonicalURL={`https://blvdpark.com/${page.slug}`}
      jsonLd={jsonLdSafe || undefined}
    >
      <section class="section-padding">
        <div style="max-width: 72rem; margin: 0 auto; padding: 0 1.5rem;">
          <h1 class="font-display text-display-md" style="margin-bottom: 2rem;">
            {page.title}
          </h1>
          {sections.map((s) =>
            s.type === "html" ? (
              <div class="cms-html" set:html={s.body} />
            ) : (
              <p style="white-space: pre-wrap;">{s.body}</p>
            )
          )}
        </div>
      </section>

      {faqItems.length > 0 && (
        <section class="section-padding" style="background: var(--blvd-cream-dark);">
          <div style="max-width: 48rem; margin: 0 auto; padding: 0 1.5rem;">
            <h2 class="font-display text-display-sm" style="margin-bottom: 2rem;">
              Frequently Asked Questions
            </h2>
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
              {faqItems.map((item) => (
                <div>
                  <h3 class="font-display" style="font-size: 1.25rem; margin-bottom: 0.5rem;">
                    {item.question}
                  </h3>
                  <div class="cms-html" set:html={item.answer} />
                </div>
              ))}
            </div>
          </div>
          {faqJsonLdSafe && <script type="application/ld+json" set:html={faqJsonLdSafe} />}
        </section>
      )}
    </Layout2026>
  ) : (
    <Layout2026 title="Page Not Found | BLVD Park" description="This page does not exist." robots="noindex, nofollow">
      <section class="section-padding" style="text-align: center;">
        <h1 class="font-display text-display-md">Page Not Found</h1>
        <p style="margin-top: 1.5rem;">
          <a href="/" style="color: var(--blvd-green);">Back to home</a>
        </p>
      </section>
    </Layout2026>
  )
}
