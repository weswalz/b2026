---
export const prerender = true;
// Reset Password Page - accepts token from query params
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Set Password | BLVD Park Admin</title>
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0d0d0d;
      color: #fff;
      min-height: 100vh;
    }
    .password-strength {
      font-size: 0.75rem;
      margin-top: 0.25rem;
    }
    .strength-weak { color: #ef4444; }
    .strength-medium { color: #f59e0b; }
    .strength-strong { color: #22C55E; }
  </style>
</head>
<body>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem;">
    <div style="width: 100%; max-width: 400px;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <div style="width: 64px; height: 64px; background: #1A5F36; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
          <span style="color: white; font-weight: 700; font-size: 1.75rem;">B</span>
        </div>
        <h1 id="page-title" style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0 0 0.25rem 0;">Set Your Password</h1>
        <p id="page-subtitle" style="color: rgba(255,255,255,0.5); font-size: 0.875rem; margin: 0;">Create a password for your admin account</p>
      </div>

      <div style="background: #1C1C1C; padding: 2rem; border-radius: 1rem; border: 1px solid rgba(255,255,255,0.1);">
        <form id="reset-form">
          <label style="display: block; margin-bottom: 1rem;">
            <span style="display: block; color: rgba(255,255,255,0.7); font-size: 0.875rem; margin-bottom: 0.5rem;">New Password</span>
            <input
              type="password"
              id="new-password"
              name="password"
              placeholder="Create a strong password"
              style="width: 100%; padding: 0.875rem 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 0.5rem; color: #fff; font-size: 1rem; outline: none; transition: border-color 0.2s;"
              onfocus="this.style.borderColor='#C9A962'"
              onblur="this.style.borderColor='rgba(255,255,255,0.15)'"
            />
            <span id="strength" class="password-strength"></span>
          </label>

          <label style="display: block; margin-bottom: 1.5rem;">
            <span style="display: block; color: rgba(255,255,255,0.7); font-size: 0.875rem; margin-bottom: 0.5rem;">Confirm Password</span>
            <input
              type="password"
              id="confirm-password"
              name="confirm_password"
              placeholder="Confirm your password"
              style="width: 100%; padding: 0.875rem 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 0.5rem; color: #fff; font-size: 1rem; outline: none; transition: border-color 0.2s;"
              onfocus="this.style.borderColor='#C9A962'"
              onblur="this.style.borderColor='rgba(255,255,255,0.15)'"
            />
          </label>

          <button
            type="submit"
            style="width: 100%; padding: 0.875rem; background: #1A5F36; color: #fff; border: none; border-radius: 0.5rem; font-size: 1rem; font-weight: 500; cursor: pointer; transition: background 0.2s;"
            onmouseover="this.style.background='#22C55E'"
            onmouseout="this.style.background='#1A5F36'"
          >
            Set Password
          </button>

          <p id="message" style="color: #22C55E; font-size: 0.875rem; text-align: center; margin-top: 1rem; display: none;"></p>
          <p id="error" style="color: #ef4444; font-size: 0.875rem; text-align: center; margin-top: 1rem; display: none;"></p>
        </form>
      </div>
    </div>
  </div>

  <script define:vars={{ apiUrl }}>
    const API_URL = (apiUrl || window.location.origin).replace(/\/$/, '');

    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    const userId = urlParams.get('user_id');

    if (!token || !userId) {
      document.getElementById('reset-form').innerHTML = `
        <p style="color: #ef4444; text-align: center;">Invalid reset link. Please request a new password reset.</p>
        <p style="text-align: center; margin-top: 1rem;">
          <a href="/admin/forgot-password" style="color: #C9A962; text-decoration: none;">Request new reset link</a>
        </p>
      `;
    }

    const form = document.getElementById('reset-form');
    const newPassword = document.getElementById('new-password');
    const confirmPassword = document.getElementById('confirm-password');
    const strength = document.getElementById('strength');
    const message = document.getElementById('message');
    const error = document.getElementById('error');

    newPassword.addEventListener('input', () => {
      const pwd = newPassword.value;
      let className = 'strength-weak';
      let text = 'Weak';

      if (pwd.length >= 8) {
        if (/[A-Z]/.test(pwd) && /[0-9]/.test(pwd) && /[^A-Za-z0-9]/.test(pwd)) {
          className = 'strength-strong';
          text = 'Strong';
        } else if (/[A-Z]/.test(pwd) || /[0-9]/.test(pwd)) {
          className = 'strength-medium';
          text = 'Medium';
        }
      }

      strength.className = 'password-strength ' + className;
      strength.textContent = pwd ? 'Strength: ' + text : '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.style.display = 'none';
      error.style.display = 'none';

      const password = newPassword.value;
      const confirm = confirmPassword.value;

      if (!password) {
        error.textContent = 'Please enter a password';
        error.style.display = 'block';
        return;
      }

      if (password.length < 8) {
        error.textContent = 'Password must be at least 8 characters';
        error.style.display = 'block';
        return;
      }

      if (password !== confirm) {
        error.textContent = 'Passwords do not match';
        error.style.display = 'block';
        return;
      }

      try {
        const res = await fetch(`${API_URL}/api/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: parseInt(userId),
            token: token,
            new_password: password
          })
        });

        const data = await res.json();

        if (res.ok) {
          document.getElementById('page-title').textContent = 'Password Set!';
          document.getElementById('page-subtitle').textContent = 'Your password has been updated successfully.';
          message.textContent = 'Redirecting to login...';
          message.style.display = 'block';
          form.style.display = 'none';
          setTimeout(() => {
            window.location.href = '/admin/login';
          }, 2000);
        } else {
          error.textContent = data.error || 'Failed to reset password';
          error.style.display = 'block';
        }
      } catch (_err) {
        error.textContent = 'Cannot connect to server. Make sure the backend is running.';
        error.style.display = 'block';
      }
    });
  </script>
</body>
</html>
