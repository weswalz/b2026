---
export const prerender = true;
// src/pages/private-events.astro - Private Events / Full Buyout page
import Layout2026 from '@layouts/Layout2026.astro';
---

<Layout2026
  title="Private Events | BLVD Park"
  description="Host your private event at BLVD Park — the Heights' premier venue for full buyouts, corporate events, and exclusive gatherings. Inquire through Tripleseat."
>

  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-end overflow-hidden" style="background: linear-gradient(180deg, #0F3D22 0%, #0d0d0d 100%);">
    <!-- Background texture -->
    <div class="absolute inset-0 z-0" style="background: radial-gradient(ellipse at 60% 40%, rgba(26,95,54,0.4) 0%, transparent 70%);"></div>

    <div class="container mx-auto px-6 relative z-10 py-24">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-2 text-white/50 hover:text-white transition-colors mb-6 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Home
        </a>

        <span class="block font-mono text-xs tracking-[0.3em] uppercase mb-4" style="color: #C9A962;">
          Private Events
        </span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4" style="font-family: 'Clash Display', sans-serif; letter-spacing: -0.02em;">
          Make It All<br/>
          <span style="color: #22C55E;">Yours</span>
        </h1>

        <p class="text-lg text-white/60 max-w-xl" style="font-family: 'Satoshi', sans-serif;">
          From corporate gatherings to milestone celebrations — BLVD Park is available for full property buyouts. Pickleball courts, bars, patios, and everything in between, reserved exclusively for your crew.
        </p>
      </div>
    </div>
  </section>

  <!-- Inquiry Form -->
  <section class="py-20" style="background: #0d0d0d;">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto">

        <!-- Section header -->
        <div class="text-center mb-12">
          <span class="inline-block font-mono text-xs tracking-[0.3em] uppercase mb-4" style="color: #C9A962;">Inquire Now</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'Clash Display', sans-serif; letter-spacing: -0.02em;">
            Tell Us About Your Event
          </h2>
          <p class="text-white/50 max-w-md mx-auto" style="font-family: 'Satoshi', sans-serif;">
            Fill out the form below and our events team will be in touch within 24 hours to discuss availability, pricing, and everything you need to make it happen.
          </p>
        </div>

        <!-- Tripleseat Form (iframe embed) -->
        <div class="rounded-3xl overflow-hidden" style="border: 1px solid rgba(255,255,255,0.06);">
          <iframe
            src="https://theclegroupllc.tripleseat.com/party_request/42255"
            width="100%"
            height="900"
            frameborder="0"
            title="Private Event Inquiry"
            style="display: block; background: #fff;"
            loading="lazy"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

</Layout2026>

