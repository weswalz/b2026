---
// Book page contact info & hours section
---

<section class="py-20" style="background: linear-gradient(180deg, #0d0d0d 0%, #121212 100%);">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Info -->
        <div>
          <span class="inline-block font-mono text-xs tracking-[0.3em] uppercase mb-4" style="color: #C9A962;" data-cms-key="book.contact.eyebrow">
            Questions?
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6" style="font-family: 'Clash Display', sans-serif;" data-cms-key="book.contact.title">
            Get in Touch
          </h2>
          <p class="text-lg mb-8" style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.body">
            Our team is happy to help with reservations, event planning, or any questions you might have.
          </p>

          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm transition-all duration-300 hover:scale-105"
            style="background: rgba(34, 197, 94, 0.1); color: #22C55E; border: 1px solid rgba(34, 197, 94, 0.2);"
            data-cms-attr="href:book.contact.cta_href"
          >
            <span data-cms-key="book.contact.cta_label">Contact Us</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Hours Card -->
        <div class="p-8 rounded-3xl" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
          <h3 class="text-xl font-bold text-white mb-6" style="font-family: 'Clash Display', sans-serif;" data-cms-key="book.contact.hours_title">
            Hours
          </h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
              <span style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.hours.0.label">Mon – Tue</span>
              <span class="font-semibold text-white" data-cms-key="book.contact.hours.0.value">4PM – 12AM</span>
            </div>
            <div class="flex justify-between items-center pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
              <span style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.hours.1.label">Wed – Thu</span>
              <span class="font-semibold text-white" data-cms-key="book.contact.hours.1.value">12PM – 12AM</span>
            </div>
            <div class="flex justify-between items-center pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
              <span style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.hours.2.label">Friday</span>
              <span class="font-semibold text-white" data-cms-key="book.contact.hours.2.value">12PM – 2AM</span>
            </div>
            <div class="flex justify-between items-center pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
              <span style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.hours.3.label">Saturday</span>
              <span class="font-semibold text-white" data-cms-key="book.contact.hours.3.value">11AM – 2AM</span>
            </div>
            <div class="flex justify-between items-center">
              <span style="color: rgba(255,255,255,0.5);" data-cms-key="book.contact.hours.4.label">Sunday</span>
              <span class="font-semibold text-white" data-cms-key="book.contact.hours.4.value">12PM – 12AM</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
