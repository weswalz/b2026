---
<!-- Fixed thin green patterned top bar with contact info and socials -->
<div class="fixed top-0 left-0 right-0 z-50 h-7 md:h-7 flex items-center justify-center text-white text-xs md:text-sm px-4"
     style="background: linear-gradient(to right, #0F5B2E, #4A7C59);">
  <div class="absolute inset-0 z-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22 viewBox=%220 0 40 40%22%3E%3Ccircle cx=%2220%22 cy=%2220%22 r=%2210%22 fill=%22%23ffffff%22 fill-opacity=%220.2%22/%3E%3C/svg%3E'); background-size: 40px 40px;"></div>
  <div class="max-w-screen-xl mx-auto w-full flex justify-between items-center">
    <div class="flex items-center gap-4">
      <a href="https://goo.gl/maps/yourLocationLink" class="hover:text-blvd-accent transition-colors">
        1119 W 20th St., Houston, TX
      </a>
    </div>
    <div class="flex items-center gap-3">
      <a href="https://instagram.com/blvdparkhtx" aria-label="Instagram" class="hover:text-blvd-accent transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
      <a href="https://facebook.com/blvdparkhtx" aria-label="Facebook" class="hover:text-blvd-accent transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
    </div>
  </div>
</div>



<header id="header" class="fixed w-full z-40 transition-all duration-300" style="top: 28px;">
  <div class="backdrop-blur-md bg-[#dce7dd] border-b border-gray-200 transition-all duration-300 sticky-top-adjust">
    <div class="max-w-screen-xl mx-auto flex flex-wrap items-center justify-between py-4 px-4 items-center gap-4">
      <a href="/" class="flex items-center transition-all duration-300">
        <img src="/images/logos/blvd-park-logo.png" class="h-14 mr-3 transition-all duration-300" alt="BLVD Park Logo" id="header-logo" />
      </a>
      <button data-collapse-toggle="navbar-default" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-blvd-green rounded-lg md:hidden hover:bg-blvd-light-green focus:outline-none focus:ring-2 focus:ring-blvd-light-green" aria-controls="navbar-default" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
      </button>
      <div class="hidden w-full md:block md:w-auto" id="navbar-default">
        <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 md:flex-row md:space-x-8 md:mt-0 md:border-0">
          <li class="relative">
            <a href="/#home" class="block py-2 pl-3 pr-4 text-blvd-green rounded hover:bg-blvd-light-green md:hover:bg-transparent md:border-0 md:p-0 md:hover:text-blvd-green relative nav-link">
              Home
              <span class="nav-highlight"></span>
            </a>
          </li>
          <li class="relative">
            <a href="/#about" class="block py-2 pl-3 pr-4 text-blvd-green rounded hover:bg-blvd-light-green md:hover:bg-transparent md:border-0 md:p-0 md:hover:text-blvd-green relative nav-link">
              About Us
              <span class="nav-highlight"></span>
            </a>
          </li>
          <li class="relative">
            <a href="/#menu" class="block py-2 pl-3 pr-4 text-blvd-green rounded hover:bg-blvd-light-green md:hover:bg-transparent md:border-0 md:p-0 md:hover:text-blvd-green relative nav-link">
              Menu
              <span class="nav-highlight"></span>
            </a>
          </li>
          <li class="relative">
            <a href="/#events" class="block py-2 pl-3 pr-4 text-blvd-green rounded hover:bg-blvd-light-green md:hover:bg-transparent md:border-0 md:p-0 md:hover:text-blvd-green relative nav-link">
              Events
              <span class="nav-highlight"></span>
            </a>
          </li>
          <li class="relative">
            <a href="/#location" class="block py-2 pl-3 pr-4 text-blvd-green rounded hover:bg-blvd-light-green md:hover:bg-transparent md:border-0 md:p-0 md:hover:text-blvd-green relative nav-link">
              Hours & Location
              <span class="nav-highlight"></span>
            </a>
          </li>
          <li>
            <a href="/book" class="block py-2 pl-3 pr-4 text-blvd-white bg-blvd-green rounded md:bg-blvd-green md:hover:bg-blvd-dark-green md:text-blvd-white md:p-2 transition-colors">Book at BLVD</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  /* Navigation Link Styles */
  .nav-link {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    letter-spacing: 0.02em;
    position: relative;
    color: var(--blvd-dark, #1A1A1A);
    display: flex;
    align-items: center;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--blvd-green, #4A7C59);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  /* Sticky header styling */
  .sticky-header {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(12px);
    background-color: rgba(255, 255, 255, 0.9);
    transition: all 0.3s ease;
    top: 0 !important;
  }

  .sticky-header .max-w-screen-xl {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    align-items: center;
  }

  .sticky-header #header-logo {
    height: 2.5rem;
  }

  /* Hide top gradient bar smoothly */
  #top-gradient-bar {
    transition: all 0.3s ease;
  }
  .hidden-top-bar {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  /* Animations */
  @keyframes subtle-shift {
    0% { background-position: 0 0; }
    100% { background-position: 12px 12px; }
  }

  @keyframes shine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .animate-subtle-shift { animation: subtle-shift 8s linear infinite; }
  .animate-shine { animation: shine 4s infinite; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const header = document.getElementById('header');
    const headerLogo = document.getElementById('header-logo');
    const navLinks = document.querySelectorAll('.nav-link');

    function setActiveLink() {
      const sections = document.querySelectorAll('section[id]');
      const scrollY = window.pageYOffset;

      sections.forEach(section => {
        const sectionElement = section as HTMLElement;
        const sectionHeight = sectionElement.offsetHeight;
        const sectionTop = sectionElement.offsetTop - 100;
        const sectionId = section.getAttribute('id');

        if(scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
          navLinks.forEach(link => {
            link.classList.remove('active');
            if(link.getAttribute('href') === `/#${sectionId}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }

    function handleScroll() {
      if (window.scrollY > 20) {
        header?.classList.add('sticky-header');
        headerLogo?.classList.add('shrink-logo');
      } else {
        header?.classList.remove('sticky-header');
        headerLogo?.classList.remove('shrink-logo');
      }
      setActiveLink();
    }

    window.addEventListener('scroll', handleScroll);
    handleScroll();
  });
</script>
