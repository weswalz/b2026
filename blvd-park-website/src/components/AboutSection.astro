---
// src/components/AboutSection.astro
import CTAButton from './CTAButton.astro';
---

<section id="blvd-park" class="px-4 bg-gray-100" style="margin-top: 0 !important; padding-top: 0 !important;">
  <div class="max-w-4xl mx-auto text-center" style="padding-top: 3rem;">
    <h2 class="text-3xl md:text-4xl font-bold mb-6 text-blvd-green">The Heights' New Playground</h2>
    <p class="text-lg mb-8 leading-relaxed text-gray-800">
      Two floors of games, drinks, and good times in the heart of the Heights. Big screens for every matchup,
      free pickleball and volleyball out back, craft cocktails at the bar, and a huge patio for hanging out.
      Come watch the game, bring the kids (until 9 PM), or just grab a drink with friends. This is what a neighborhood sports bar should feel like.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
      <CTAButton href="/#menu" color="green">View Our Menu</CTAButton>
      <CTAButton href="/book" color="white">Book VIP Table</CTAButton>
    </div>
    
    <div class="mt-8 text-center pb-8">
      <p class="text-lg">1119 W 20th St., Houston, TX</p>
    </div>
  </div>
</section>
