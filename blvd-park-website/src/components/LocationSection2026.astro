---
// src/components/LocationSection2026.astro
// 2026 Redesign - Glass-morphism cards with consistent dark aesthetic

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
---

<section id="hours-location" class="location-2026 relative section-padding overflow-hidden bg-dark-base">

  <!-- Ambient gradient orbs -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full opacity-10 blur-[100px] bg-blvd-green"></div>
  <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] rounded-full opacity-10 blur-[100px] bg-blvd-gold"></div>

  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="location-header text-center mb-16" style="opacity: 0; transform: translateY(30px);">
      <span class="eyebrow inline-block mb-4" data-cms-key="home.location.eyebrow">Find Us</span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight" data-cms-key="home.location.headline">
        Hours & Location
      </h2>
      <p class="font-body text-base md:text-lg max-w-lg mx-auto text-white/50" data-cms-key="home.location.subtext">
        In the heart of The Heights, Houston
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">

      <!-- Hours Card -->
      <div class="location-card glass-card p-6 md:p-8 rounded-3xl" style="opacity: 0; transform: translateY(30px);">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-gradient-to-br from-blvd-green/30 to-blvd-green-bright/10">
            <svg class="w-6 h-6 text-blvd-green-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white" data-cms-key="home.location.hours_title">Hours</h3>
        </div>

        <div class="space-y-4" id="hours-list">
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="1">
            <span class="font-body text-white/60" data-cms-key="global.days.1">Monday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="2">
            <span class="font-body text-white/60" data-cms-key="global.days.2">Tuesday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="3">
            <span class="font-body text-white/60" data-cms-key="global.days.3">Wednesday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="4">
            <span class="font-body text-white/60" data-cms-key="global.days.4">Thursday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="5">
            <span class="font-body text-white/60" data-cms-key="global.days.5">Friday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-white/[0.08]" data-day="6">
            <span class="font-body text-white/60" data-cms-key="global.days.6">Saturday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
          <div class="flex justify-between items-center" data-day="0">
            <span class="font-body text-white/60" data-cms-key="global.days.0">Sunday</span>
            <span class="font-body font-semibold text-white" data-cms-key="global.status.loading">Loading...</span>
          </div>
        </div>
      </div>

      <!-- Address Card -->
      <div class="location-card glass-card p-6 md:p-8 rounded-3xl" style="opacity: 0; transform: translateY(30px);">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-gradient-to-br from-blvd-gold/30 to-blvd-gold/10">
            <svg class="w-6 h-6 text-blvd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white" data-cms-key="home.location.address_title">Location</h3>
        </div>

        <div class="mb-8">
          <p class="font-display text-2xl font-semibold text-white mb-2" data-cms-key="home.location.address_line1">
            1119 W 20th Street
          </p>
          <p class="font-body text-lg text-white/60" data-cms-key="home.location.address_line2">
            Houston, TX 77008
          </p>
          <p class="mt-4 font-body text-sm text-white/40" data-cms-key="home.location.address_note">
            The Heights • Free parking available
          </p>
        </div>

        <a
          href="https://maps.google.com/?q=1119+W+20th+St,+Houston,+TX+77008"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 hover:scale-105 bg-blvd-gold/15 text-blvd-gold border border-blvd-gold/20 hover:bg-blvd-gold/25"
          data-cms-attr="href:home.location.directions_href"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          <span data-cms-key="home.location.directions_label">Get Directions</span>
        </a>
      </div>

      <!-- Contact Card -->
      <div class="location-card glass-card p-6 md:p-8 rounded-3xl md:col-span-2 lg:col-span-1" style="opacity: 0; transform: translateY(30px);">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-gradient-to-br from-blvd-green-bright/30 to-blvd-green/10">
            <svg class="w-6 h-6 text-blvd-green-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white" data-cms-key="home.location.connect_title">Connect</h3>
        </div>

        <div class="space-y-6">
          <div>
            <span class="block font-mono text-xs uppercase tracking-wider mb-3 text-white/40" data-cms-key="home.location.follow_label">Follow Us</span>
            <div class="flex gap-3">
              <a
                href="https://instagram.com/blvdparkhtx"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20"
                aria-label="Instagram"
                data-cms-key="social.instagram"
                data-cms-attr="href:social.instagram"
              >
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a
                href="https://facebook.com/blvdparkhtx"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20"
                aria-label="Facebook"
                data-cms-key="social.facebook"
                data-cms-attr="href:social.facebook"
              >
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Map Embed -->
    <div class="location-map rounded-3xl overflow-hidden border border-white/[0.08]" style="opacity: 0; transform: translateY(30px);">
      <div class="relative h-[300px] md:h-[400px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3462.6384254673!2d-95.41513548488878!3d29.805361381970723!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8640c70c3a6b30d5%3A0x9c8c8c6c8c8c8c8c!2s1119%20W%2020th%20St%2C%20Houston%2C%20TX%2077008!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%"
          height="100%"
          style="border:0; filter: grayscale(100%) invert(92%) contrast(83%);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          data-cms-attr="src:home.location.map_embed_url"
        ></iframe>

        <!-- Map overlay gradient -->
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-[#0d0d0d]/30 via-transparent to-[#0d0d0d]/30"></div>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ apiUrl }}>
  const getContentValue = (key, fallback) => (window.__blvdContent && window.__blvdContent[key]) || fallback;

  const parseTimeToMinutes = (value) => {
    if (!value) return null;
    const [hoursRaw, minutesRaw] = value.split(':');
    if (hoursRaw === undefined || minutesRaw === undefined) return null;
    const hours = Number(hoursRaw);
    const minutes = Number(minutesRaw);
    if (Number.isNaN(hours) || Number.isNaN(minutes)) return null;
    return (hours * 60) + minutes;
  };

  const formatMinutesToTime = (totalMinutes, options = {}) => {
    const { uppercase = false, alwaysShowMinutes = false } = options;
    const normalized = totalMinutes === 1440 ? 0 : totalMinutes;
    if (normalized === 0) {
      const suffix = uppercase ? 'AM' : 'am';
      const minuteLabel = alwaysShowMinutes ? ':00' : '';
      return `12${minuteLabel}${suffix}`;
    }
    const hour24 = Math.floor(normalized / 60) % 24;
    const minute = normalized % 60;
    const suffix = hour24 >= 12 ? (uppercase ? 'PM' : 'pm') : (uppercase ? 'AM' : 'am');
    let hour12 = hour24 % 12;
    if (hour12 === 0) hour12 = 12;
    const showMinutes = alwaysShowMinutes || minute !== 0;
    const minuteLabel = showMinutes ? `:${minute.toString().padStart(2, '0')}` : '';
    return `${hour12}${minuteLabel}${suffix}`;
  };

  const formatRange = (entry) => {
    const closedLabel = getContentValue('global.status.closed_label', 'Closed');
    if (!entry || entry.isClosed) return closedLabel;
    const open = parseTimeToMinutes(entry.openTime);
    const close = parseTimeToMinutes(entry.closeTime);
    if (open === null || close === null) return closedLabel;
    return `${formatMinutesToTime(open, { uppercase: true })} – ${formatMinutesToTime(close, { uppercase: true })}`;
  };

  async function loadHours() {
    if (window.__blvdHoursData) return window.__blvdHoursData;
    try {
      const res = await fetch(`${apiUrl}/api/hours`);
      if (!res.ok) throw new Error('Failed to fetch hours');
      const hours = await res.json();
      if (!Array.isArray(hours) || hours.length === 0) throw new Error('No hours');
      window.__blvdHoursData = hours;
      return hours;
    } catch (_error) {
      window.__blvdHoursData = null;
      return null;
    }
  }

  const locationObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const header = entry.target.querySelector('.location-header');
          if (header) {
            header.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
            header.style.opacity = '1';
            header.style.transform = 'translateY(0)';
          }

          const cards = entry.target.querySelectorAll('.location-card');
          cards.forEach((card, index) => {
            setTimeout(() => {
              card.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, 200 + (index * 150));
          });

          setTimeout(() => {
            const map = entry.target.querySelector('.location-map');
            if (map) {
              map.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
              map.style.opacity = '1';
              map.style.transform = 'translateY(0)';
            }
          }, 700);

          locationObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.addEventListener('DOMContentLoaded', () => {
    const hoursList = document.getElementById('hours-list');
    if (!hoursList) return;

    const renderHours = (hours) => {
      const unavailableLabel = getContentValue('global.status.hours_unavailable', 'Hours unavailable');
      const rows = hoursList.querySelectorAll('[data-day]');
      if (!Array.isArray(hours)) {
        rows.forEach((row) => {
          const timeEl = row.querySelector('span:last-child');
          if (timeEl) timeEl.textContent = unavailableLabel;
        });
        return;
      }
      rows.forEach((row) => {
        const day = parseInt(row.getAttribute('data-day'), 10);
        const entry = hours.find((item) => item.dayOfWeek === day);
        if (!entry) return;
        const timeEl = row.querySelector('span:last-child');
        if (!timeEl) return;
        const note = entry.note ? ` · ${entry.note}` : '';
        timeEl.textContent = `${formatRange(entry)}${note}`;
      });
    };

    const refreshHours = () => loadHours().then(renderHours);

    refreshHours();

    document.addEventListener('blvd:hours', () => {
      window.__blvdHoursData = null;
      refreshHours();
    });

    if (window.__blvdSubscribeContent) {
      window.__blvdSubscribeContent(() => {
        renderHours(window.__blvdHoursData);
      });
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.location-2026');
    if (section) locationObserver.observe(section);
  });
</script>
