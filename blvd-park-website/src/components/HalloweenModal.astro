---
// Halloween promotional modal component
---

<div id="halloween-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <!-- Mobile Layout -->
  <div class="md:hidden relative w-[90vw] max-h-[85vh] bg-gray-900 border-2 border-yellow-500 rounded-2xl overflow-y-auto shadow-2xl animate-fade-in">
    <!-- Close button -->
    <button
      id="close-halloween-modal-mobile"
      class="absolute top-4 right-4 z-10 text-yellow-500 hover:text-white transition-colors bg-gray-900/90 rounded-full p-2"
      aria-label="Close modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Video Container -->
    <div class="w-full p-8 bg-gray-900">
      <video
        id="halloween-video-mobile"
        autoplay
        muted
        loop
        playsinline
        class="w-full h-auto rounded-xl"
      >
        <source src="https://heightssocialhtx.com/images/allhalloween-mobile.webm" type="video/webm" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Content -->
    <div class="p-8 text-center">
      <div class="mb-4">
        <h2 class="text-4xl font-bold text-yellow-500 leading-tight tracking-widest">
          SKIP THE LINE
        </h2>
        <p class="text-3xl font-semibold text-orange-500 mt-1 leading-tight tracking-widest">
          HALLOWEEN NIGHT
        </p>
        <p class="text-xl font-medium text-yellow-500/70 mt-0.5 leading-tight tracking-widest">
          FRIDAY OCTOBER 31ST
        </p>
      </div>
      <p class="text-sm text-gray-100 mb-6 leading-relaxed">
        Get your 4 venue + 2 drink pass for this Friday!
      </p>

      <!-- CTA Button -->
      <div class="flex justify-center">
        <a
          href="https://clelink.co/HALLOWEEN"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold bg-yellow-500 text-gray-900 rounded-lg hover:bg-yellow-400 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl group"
        >
          <span>GET TICKETS</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Desktop Layout -->
  <div class="hidden md:block relative w-full max-w-5xl max-h-[85vh] bg-gray-900 border-2 border-yellow-500 rounded-2xl overflow-hidden shadow-2xl animate-fade-in">
    <!-- Close button -->
    <button
      id="close-halloween-modal-desktop"
      class="absolute top-4 right-4 z-10 text-yellow-500 hover:text-white transition-colors bg-gray-900/90 rounded-full p-2"
      aria-label="Close modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Two column layout -->
    <div class="grid grid-cols-2 gap-0">
      <!-- Left: Video -->
      <div class="relative bg-gray-900 flex items-center justify-center p-6">
        <video
          id="halloween-video-desktop"
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover rounded-xl"
        >
          <source src="https://heightssocialhtx.com/images/allhalloween.webm" type="video/webm" />
          Your browser does not support the video tag.
        </video>
      </div>

      <!-- Right: Content -->
      <div class="flex flex-col justify-center p-10 lg:p-14 text-center bg-gray-900">
        <div class="mb-6">
          <h2 class="text-4xl lg:text-5xl font-bold text-yellow-500 leading-tight tracking-wide">
            SKIP THE LINE
          </h2>
          <p class="text-3xl lg:text-4xl font-semibold text-orange-500 mt-2 leading-tight tracking-wide">
            HALLOWEEN NIGHT
          </p>
          <p class="text-xl lg:text-2xl font-medium text-yellow-500/70 mt-1 leading-tight tracking-wider">
            FRIDAY OCTOBER 31ST
          </p>
        </div>
        <p class="text-base lg:text-lg text-gray-100 mb-10 leading-relaxed">
          Get your 4 venue + 2 drink pass for this Friday!
        </p>

        <div class="flex justify-center">
          <a
            href="https://clelink.co/HALLOWEEN"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold bg-yellow-500 text-gray-900 rounded-lg hover:bg-yellow-400 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl group"
          >
            <span>GET TICKETS</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }

  /* Prevent body scroll when modal is open */
  body.modal-open {
    overflow: hidden;
  }
</style>

<script>
  // Optimized modal functionality
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('halloween-modal');
    const closeBtnMobile = document.getElementById('close-halloween-modal-mobile');
    const closeBtnDesktop = document.getElementById('close-halloween-modal-desktop');
    const videoMobile = document.getElementById('halloween-video-mobile');
    const videoDesktop = document.getElementById('halloween-video-desktop');

    if (!modal) return;

    const modalDismissed = sessionStorage.getItem('halloween-modal-dismissed');

    if (!modalDismissed) {
      // Show modal immediately
      setTimeout(() => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('modal-open');
      }, 500); // Small delay to ensure page is settled
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('modal-open');
      sessionStorage.setItem('halloween-modal-dismissed', 'true');
      if (videoMobile) videoMobile.pause();
      if (videoDesktop) videoDesktop.pause();
    }

    closeBtnMobile?.addEventListener('click', closeModal);
    closeBtnDesktop?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => e.target === modal && closeModal());
    document.addEventListener('keydown', (e) => e.key === 'Escape' && !modal.classList.contains('hidden') && closeModal());
  });
</script>
