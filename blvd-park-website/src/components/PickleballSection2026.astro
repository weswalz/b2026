---
// src/components/PickleballSection2026.astro
// 2026 Refresh - Full-bleed hero style with floating card
// Sleek social club aesthetic
---

<section id="pickleball" class="pickleball-2026 relative min-h-[90vh] flex items-center overflow-hidden">
  
  <!-- Full background image -->
  <div class="absolute inset-0 z-0">
    <div class="pickleball-bg absolute inset-0">
      <img 
        src="/images/pickleballhome.jpg" 
        alt="Pickleball at BLVD Park"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30"></div>
    <!-- Green accent -->
    <div class="absolute bottom-0 left-0 w-full h-1/4 bg-gradient-to-t from-[#1A5F36]/30 to-transparent"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 container mx-auto px-5 sm:px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      
      <!-- Eyebrow -->
      <div class="pickleball-eyebrow opacity-0 mb-6">
        <span class="inline-flex items-center gap-2 font-mono text-xs text-[#22C55E] tracking-[0.2em] uppercase">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#22C55E]"></span>
          </span>
          Courts Open Daily
        </span>
      </div>
      
      <!-- Headline -->
      <h2 class="pickleball-headline opacity-0 font-display font-bold text-5xl sm:text-6xl md:text-7xl text-white leading-[0.9] tracking-tight mb-6">
        Pickleball in<br/>
        <span class="bg-gradient-to-r from-[#22C55E] to-[#4ADE80] bg-clip-text text-transparent">The Heights</span>
      </h2>
      
      <!-- Description -->
      <p class="pickleball-desc opacity-0 text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-lg">
        Our courts are open daily and always free — no reservations, no memberships, no gatekeeping. Paddle in one hand, drink in the other.
      </p>
      
      <!-- Hours strip - inline on mobile -->
      <div class="pickleball-hours opacity-0 flex flex-wrap gap-3 mb-10">
        <div class="px-4 py-3 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
          <span class="block text-xs font-mono text-[#C9A962] uppercase tracking-wider">Mon-Tue</span>
          <span class="block text-sm font-display font-semibold text-white">4PM-12AM</span>
        </div>
        <div class="px-4 py-3 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
          <span class="block text-xs font-mono text-[#C9A962] uppercase tracking-wider">Wed-Thu</span>
          <span class="block text-sm font-display font-semibold text-white">12PM-12AM</span>
        </div>
        <div class="px-4 py-3 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
          <span class="block text-xs font-mono text-[#C9A962] uppercase tracking-wider">Friday</span>
          <span class="block text-sm font-display font-semibold text-white">12PM-2AM</span>
        </div>
        <div class="px-4 py-3 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
          <span class="block text-xs font-mono text-[#C9A962] uppercase tracking-wider">Saturday</span>
          <span class="block text-sm font-display font-semibold text-white">11AM-2AM</span>
        </div>
        <div class="px-4 py-3 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
          <span class="block text-xs font-mono text-[#C9A962] uppercase tracking-wider">Sunday</span>
          <span class="block text-sm font-display font-semibold text-white">12PM-12AM</span>
        </div>
      </div>
      
      <!-- CTAs -->
      <div class="pickleball-cta opacity-0 flex flex-wrap gap-4">
        <a 
          href="https://maps.google.com/?q=1119+W+20th+St,+Houston,+TX+77008" 
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-7 py-4 bg-[#1A5F36] text-white font-display font-semibold rounded-full transition-all duration-300 hover:bg-[#22C55E] hover:shadow-[0_0_30px_rgba(34,197,94,0.3)]"
        >
          Get Directions
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </a>
      </div>
      
    </div>
  </div>
  
  <!-- Floating "FREE" badge -->
  <div class="pickleball-badge opacity-0 absolute bottom-10 right-10 md:bottom-16 md:right-16 hidden md:block">
    <div class="relative">
      <div class="w-28 h-28 rounded-full bg-[#1A5F36] flex flex-col items-center justify-center shadow-2xl border-2 border-[#22C55E]/30">
        <span class="font-display font-bold text-3xl text-white">FREE</span>
        <span class="font-mono text-[10px] text-white/70 uppercase tracking-wider">Pickleball</span>
      </div>
      <!-- Animated ring -->
      <div class="absolute inset-0 rounded-full border-2 border-[#22C55E]/20 animate-ping"></div>
    </div>
  </div>
  
</section>

<style>
  .pickleball-eyebrow,
  .pickleball-headline,
  .pickleball-desc,
  .pickleball-hours,
  .pickleball-cta,
  .pickleball-badge {
    animation: slideReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .pickleball-eyebrow { animation-delay: 0.1s; }
  .pickleball-headline { animation-delay: 0.2s; }
  .pickleball-desc { animation-delay: 0.3s; }
  .pickleball-hours { animation-delay: 0.4s; }
  .pickleball-cta { animation-delay: 0.5s; }
  .pickleball-badge { animation-delay: 0.6s; }
  
  @keyframes slideReveal {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const elements = entry.target.querySelectorAll(
            '.pickleball-eyebrow, .pickleball-headline, .pickleball-desc, .pickleball-hours, .pickleball-cta, .pickleball-badge'
          );
          elements.forEach(el => {
            (el as HTMLElement).style.animationPlayState = 'running';
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );
  
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.pickleball-2026');
    if (section) {
      section.querySelectorAll('.pickleball-eyebrow, .pickleball-headline, .pickleball-desc, .pickleball-hours, .pickleball-cta, .pickleball-badge').forEach(el => {
        (el as HTMLElement).style.animationPlayState = 'paused';
      });
      observer.observe(section);
    }
  });
</script>
