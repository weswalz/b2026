---
// src/components/MasonryGallery.astro - Masonry gallery layout component
// Creates a Pinterest-style masonry layout for images

interface Props {
  images: Array<{
    src: string;
    alt: string;
  }>;
}

const { images = [] } = Astro.props;
---

<!-- Lightbox overlays -->
{images.map((image, index) => {
  const lightboxId = `masonry-lightbox-${index}`;
  
  return (
    <div id={lightboxId} class="lightbox">
      <div class="lightbox-backdrop">
        <a href="#" class="lightbox-close-area"></a>
        <div class="lightbox-content">
          <a href="#" class="lightbox-close-btn">&times;</a>
          <img src={image.src} alt={image.alt} class="lightbox-image" />
        </div>
      </div>
    </div>
  );
})}

<!-- Masonry container -->
<div class="masonry-container">
  {images.map((image, index) => {
    const lightboxId = `masonry-lightbox-${index}`;
    // Create visual variety by applying different aspect ratios to some images
    const heightClasses = [
      '', // default
      'masonry-tall',
      '',
      'masonry-short',
      '',
      'masonry-tall',
      '',
      '',
      'masonry-short',
      '',
      'masonry-tall',
      '',
      'masonry-short',
      '',
      '',
      'masonry-tall',
      '',
      'masonry-short',
      '',
      ''
    ];
    const heightClass = heightClasses[index % heightClasses.length];
    
    return (
      <div class={`masonry-item ${heightClass}`}>
        <a href={`#${lightboxId}`} class="masonry-link">
          <img
            src={image.src}
            alt={image.alt}
            class="masonry-image"
            loading={index < 4 ? "eager" : "lazy"}
          />
        </a>
      </div>
    );
  })}
</div>

<style>
  /* Masonry Layout */
  .masonry-container {
    column-count: 2;
    column-gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .masonry-container {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-container {
      column-count: 4;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    position: relative;
  }

  .masonry-link {
    display: block;
    overflow: hidden;
    border-radius: 0.75rem;
    background-color: #f0f0f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .masonry-link:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .masonry-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }

  .masonry-link:hover .masonry-image {
    transform: scale(1.08);
  }

  /* Height variations for masonry effect */
  .masonry-tall .masonry-link {
    aspect-ratio: 3/4;
  }

  .masonry-short .masonry-link {
    aspect-ratio: 4/3;
  }

  .masonry-tall .masonry-image,
  .masonry-short .masonry-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox:target {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .lightbox-close-area {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    text-align: center;
  }

  .lightbox-close-btn {
    position: absolute;
    top: -40px;
    right: 0;
    color: white;
    font-size: 36px;
    font-weight: bold;
    text-decoration: none;
    z-index: 10;
    transition: color 0.3s ease;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close-btn:hover {
    color: #ccc;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
  }

  /* Animation for lightbox */
  .lightbox:target .lightbox-content {
    animation: lightboxIn 0.3s ease-out;
  }

  @keyframes lightboxIn {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>