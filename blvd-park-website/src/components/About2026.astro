---
// src/components/About2026.astro
// 2026 Refresh - Editorial asymmetric layout
// Elevated social club aesthetic with dramatic typography
---

<section id="blvd-park" class="about-2026 relative overflow-hidden bg-blvd-cream">
  <!-- Decorative corner accent -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-blvd-green/[0.03] to-transparent pointer-events-none"></div>

  <div class="container mx-auto px-5 sm:px-6">
    <!-- Desktop: Asymmetric two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-0 items-stretch min-h-[90vh] lg:min-h-0">

      <!-- Left: Content Column -->
      <div class="lg:col-span-5 flex flex-col justify-center py-16 md:py-24 lg:py-32 lg:pr-12 order-2 lg:order-1">
        <div class="about-content opacity-0">
          <!-- Eyebrow -->
          <span class="inline-flex items-center gap-2 font-mono text-xs text-blvd-green tracking-[0.2em] uppercase mb-6">
            <span class="w-8 h-px bg-blvd-green/30"></span>
            About Us
          </span>
          
          <!-- Headline - More dramatic -->
          <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-blvd-charcoal mb-6 leading-[0.95] tracking-tight">
            Where Houston<br/>
            <span class="text-blvd-green">Comes to Play</span>
          </h2>

          <!-- Body copy - refined -->
          <div class="space-y-4 text-blvd-charcoal/70 text-base sm:text-lg leading-relaxed font-body max-w-md">
            <p>
              Part sports bar, part social club, part neighborhood living room. BLVD Park is where the Heights comes when they want to watch the game, grab a drink, or just be around good energy.
            </p>
            <p>
              Free pickleball, a bar that actually knows what it's doing, and enough TVs that you'll never miss a play. Come solo or bring the crew.
            </p>
          </div>
          
          <!-- Stats row -->
          <div class="flex items-center gap-8 mt-10 pt-10 border-t border-blvd-charcoal/10">
            <div>
              <div class="font-display font-bold text-3xl text-blvd-green">FREE</div>
              <div class="font-mono text-xs text-blvd-charcoal/50 tracking-wide uppercase">Pickleball</div>
            </div>
            <div class="w-px h-10 bg-blvd-charcoal/10"></div>
            <div>
              <div class="font-display font-bold text-3xl text-blvd-green">50+</div>
              <div class="font-mono text-xs text-blvd-charcoal/50 tracking-wide uppercase">HD Screens</div>
            </div>
            <div class="w-px h-10 bg-blvd-charcoal/10"></div>
            <div>
              <div class="font-display font-bold text-3xl text-blvd-green">7</div>
              <div class="font-mono text-xs text-blvd-charcoal/50 tracking-wide uppercase">Days/Week</div>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-4 mt-10">
            <a
              href="/book2026"
              class="group inline-flex items-center gap-2 px-6 py-3.5 bg-blvd-green text-white font-display font-semibold text-sm rounded-full transition-all duration-300 hover:bg-blvd-green-bright hover:shadow-lg hover:shadow-blvd-green-bright/25"
            >
              Book an Event
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Right: Image Column - Full bleed on desktop -->
      <div class="lg:col-span-7 relative order-1 lg:order-2">
        <div class="about-images opacity-0 h-full">
          <!-- Main image container -->
          <div class="relative h-[50vh] sm:h-[60vh] lg:h-full lg:absolute lg:inset-0 lg:left-8">
            <!-- Primary image -->
            <div class="h-full rounded-2xl lg:rounded-l-3xl lg:rounded-r-none overflow-hidden shadow-2xl">
              <img 
                src="/images/2026GALLERY/DSC03577.jpg"
                alt="BLVD Park Atmosphere"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            
            <!-- Floating accent card -->
            <div class="absolute -bottom-6 left-4 sm:left-8 lg:-left-16 bg-white rounded-2xl shadow-xl p-5 max-w-[200px]">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full bg-blvd-green/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-blvd-green" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <div class="font-display font-bold text-sm text-blvd-charcoal">The Heights</div>
                  <div class="font-mono text-xs text-blvd-charcoal/50">Houston, TX</div>
                </div>
              </div>
              <div class="h-20 rounded-lg overflow-hidden">
                <img 
                  src="/images/2026GALLERY/DSC01726.jpg"
                  alt="BLVD Park"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Animation classes */
  .about-content,
  .about-images {
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .about-content.animate-in {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .about-images.animate-in {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }
  
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.about-content, .about-images').forEach(el => {
            el.classList.add('animate-in');
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.about-2026');
    if (section) observer.observe(section);
  });
</script>
