---
// src/components/VibeSection2026.astro
// 2026 Redesign - Social proof + vibe showcase

const stats = [
  { value: "4.8", label: "Google Rating", suffix: "★" },
  { value: "50+", label: "Screens", suffix: "" },
  { value: "4", label: "Courts", suffix: "" },
  { value: "2am", label: "Open Late", suffix: "" }
];

const vibes = [
  {
    title: "Date Night",
    description: "Craft cocktails, mood lighting, and enough games to break the ice without trying too hard.",
    icon: "cocktail",
    gradient: "from-blvd-gold/20 to-transparent"
  },
  {
    title: "Game Day HQ",
    description: "Every seat's a good seat. 50+ screens, sound on for the big games, and a crowd that actually cares.",
    icon: "tv",
    gradient: "from-blvd-green-bright/20 to-transparent"
  },
  {
    title: "Late Night",
    description: "When everywhere else closes. Strong pours, late night bites, and the stories that come with them.",
    icon: "moon",
    gradient: "from-blvd-green/30 to-transparent"
  }
];
---

<section class="vibe-2026 relative section-padding overflow-hidden bg-dark-base">

  <!-- Ambient orbs -->
  <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-10 blur-3xl bg-blvd-green-bright"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] rounded-full opacity-[0.08] blur-3xl bg-blvd-gold"></div>

  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="container mx-auto px-6 relative z-10">

    <!-- Stats Bar -->
    <div class="stats-bar mb-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {stats.map((stat, index) => (
          <div
            class="stat-card group glass-card text-center p-6 md:p-8 rounded-2xl transition-all duration-500 hover:scale-105 cursor-default"
            data-index={index}
          >
            <div class="flex items-baseline justify-center gap-1 mb-2">
              <span
                class="font-display text-3xl md:text-4xl font-bold text-white transition-colors duration-300 group-hover:text-blvd-green-bright"
                data-cms-key={`home.vibe.stats.${index}.value`}
              >
                {stat.value}
              </span>
              {stat.suffix && (
                <span class="text-xl md:text-2xl text-blvd-gold" data-cms-key={`home.vibe.stats.${index}.suffix`}>{stat.suffix}</span>
              )}
            </div>
            <span class="font-mono text-xs font-medium tracking-wide uppercase text-white/40" data-cms-key={`home.vibe.stats.${index}.label`}>
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="eyebrow inline-block mb-4 px-4 py-2 rounded-full border border-blvd-gold/20 bg-blvd-gold/5">
        <span data-cms-key="home.vibe.eyebrow">The Vibe</span>
      </span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-white tracking-tight" data-cms-key="home.vibe.headline">
        Your Kind of Night
      </h2>
      <p class="font-body text-lg md:text-xl max-w-2xl mx-auto text-white/50" data-cms-key="home.vibe.subtext">
        Whether you're here for the game, the drinks, or the company—we've got a spot for you.
      </p>
    </div>

    <!-- Vibe Cards -->
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
      {vibes.map((vibe, index) => (
        <div
          class="vibe-card group relative glass-card p-6 md:p-8 rounded-3xl transition-all duration-500 hover:-translate-y-2 cursor-default overflow-hidden"
          data-index={index}
        >
          <!-- Hover gradient background -->
          <div class={`absolute inset-0 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br ${vibe.gradient}`}></div>

          <div class="relative z-10">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6 transition-all duration-300 group-hover:scale-110 bg-gradient-to-br from-blvd-green/30 to-blvd-green-bright/20 border border-blvd-green-bright/20">
              {vibe.icon === 'cocktail' && (
                <svg class="w-6 h-6 text-blvd-green-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {vibe.icon === 'tv' && (
                <svg class="w-6 h-6 text-blvd-green-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {vibe.icon === 'moon' && (
                <svg class="w-6 h-6 text-blvd-green-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                </svg>
              )}
            </div>

            <h3 class="font-display text-xl font-bold mb-3 text-white transition-colors duration-300 group-hover:text-blvd-green-bright" data-cms-key={`home.vibe.cards.${index}.title`}>
              {vibe.title}
            </h3>
            <p class="font-body text-base leading-relaxed text-white/50" data-cms-key={`home.vibe.cards.${index}.description`}>
              {vibe.description}
            </p>
          </div>

          <!-- Corner accent -->
          <div class="absolute bottom-4 right-4 w-8 h-8 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-100 scale-0 bg-blvd-gold/20"></div>
        </div>
      ))}
    </div>

    <!-- Pull Quote -->
    <div class="quote-section max-w-3xl mx-auto text-center">
      <div class="relative inline-block">
        <svg class="absolute -top-4 -left-8 w-12 h-12 opacity-10 text-blvd-green-bright" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <blockquote class="font-body text-2xl md:text-3xl font-medium italic mb-6 text-white leading-snug" data-cms-key="home.vibe.quote">
          "Best spot in the Heights. Period. Come for the games, stay for the vibes."
        </blockquote>
        <cite class="not-italic">
          <span class="font-semibold text-white/70">— <span data-cms-key="home.vibe.cite_name">Google Review</span></span>
          <span class="mx-2 text-white/20">•</span>
          <span class="text-sm text-blvd-gold" data-cms-key="home.vibe.cite_rating">★★★★★</span>
        </cite>
      </div>
    </div>

  </div>

</section>

<style>
  .stat-card {
    animation: fadeInUp 0.6s cubic-bezier(0.19, 1, 0.22, 1) backwards;
  }

  .stat-card[data-index="0"] { animation-delay: 0.1s; }
  .stat-card[data-index="1"] { animation-delay: 0.2s; }
  .stat-card[data-index="2"] { animation-delay: 0.3s; }
  .stat-card[data-index="3"] { animation-delay: 0.4s; }

  .vibe-card {
    animation: fadeInUp 0.6s cubic-bezier(0.19, 1, 0.22, 1) backwards;
  }

  .vibe-card[data-index="0"] { animation-delay: 0.2s; }
  .vibe-card[data-index="1"] { animation-delay: 0.3s; }
  .vibe-card[data-index="2"] { animation-delay: 0.4s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .vibe-card:hover {
    box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 40px rgba(34, 197, 94, 0.05);
    border-color: rgba(34, 197, 94, 0.15);
  }

  .stat-card:hover {
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .quote-section {
    animation: fadeIn 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.5s backwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
