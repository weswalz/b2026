---
// src/components/BLVDGallerySection.astro - Photo gallery section
// Displays a mixed grid of BLVD Park crowd and food images
import GalleryGrid from './GalleryGrid.astro';

// Mixed crowd and food images - first row fixed, then crowd/food evenly distributed
const galleryImages = [
  // Row 1 - fixed order
  { src: "/images/food/blvdnewhome214.webp", alt: "BLVD Park selections" },
  { src: "/images/crowd/blvdnewhome9.webp", alt: "BLVD Park vibes" },
  { src: "/images/crowd/blvdnewhome6.webp", alt: "BLVD Park nightlife" },
  { src: "/images/food/blvdnewhome212.webp", alt: "BLVD Park specials" },
  // Row 2
  { src: "/images/crowd/blvdnewhome01.webp", alt: "BLVD Park crowd" },
  { src: "/images/food/blvdnewhome21.webp", alt: "BLVD Park cuisine" },
  { src: "/images/crowd/blvdnewhome02.webp", alt: "BLVD Park night" },
  { src: "/images/food/blvdnewhome22.webp", alt: "BLVD Park dishes" },
  // Row 3
  { src: "/images/crowd/blvdnewhome03.webp", alt: "BLVD Park social" },
  { src: "/images/crowd/blvdnewhome04.webp", alt: "BLVD Park vibe" },
  { src: "/images/food/blvdnewhome24.webp", alt: "BLVD Park menu" },
  // Row 4
  { src: "/images/crowd/blvdnewhome1.webp", alt: "BLVD Park atmosphere" },
  { src: "/images/food/blvdnewhome25.webp", alt: "BLVD Park dining" },
  { src: "/images/food/blvdnewhome27.webp", alt: "BLVD Park culinary" },
  // Row 5
  { src: "/images/crowd/blvdnewhome3.webp", alt: "BLVD Park guests" },
  { src: "/images/food/blvdnewhome211.webp", alt: "BLVD Park flavors" },
  { src: "/images/crowd/blvdnewhome4.webp", alt: "BLVD Park celebration" },
  { src: "/images/food/blvdnewhome219.webp", alt: "BLVD Park signature dishes" },
  // Row 6
  { src: "/images/crowd/blvdnewhome5.webp", alt: "BLVD Park event" },
  { src: "/images/crowd/blvdnewhome7.webp", alt: "BLVD Park experience" },
];
---

<!-- Gallery section with BLVD Park brand green background -->
<section class="py-16 bg-blvd-green text-blvd-white" data-gallery>
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section heading -->
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">It's a BLVD Thing</h2>
    <div class="mx-auto">
      <!-- 
        GalleryGrid component renders the image grid
        - images: Array of image objects with src and alt properties
        - columns: Number of columns in the grid
        - gap: Space between images
      -->
      <GalleryGrid
        images={galleryImages}
        columns={4}
        gap="gap-4"
      />
    </div>
  </div>
</section>