---
// src/components/Navbar2026.astro
// 2026 Redesign - Premium navbar with fullscreen mobile flyout
---

<header class="navbar-2026 fixed top-0 left-0 right-0 z-50">
  <!-- Glass backdrop -->
  <div class="navbar-glass absolute inset-0 transition-all duration-500"></div>

  <nav class="container mx-auto px-6 relative z-10">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="/" class="navbar-logo flex items-center group">
        <img
          src="/images/logos/blvd-park-logo.webp"
          alt="BLVD Park"
          class="logo-img h-10 w-auto transition-all duration-300 group-hover:scale-105"
        />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="/menu" class="nav-link px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
          Menu
        </a>
        <a href="/#pickleball" class="nav-link px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
          Pickleball
        </a>
        <a href="/#events" class="nav-link px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
          Events
        </a>
        <a href="/#hours-location" class="nav-link px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
          Hours
        </a>
      </div>

      <!-- Right Side -->
      <div class="flex items-center gap-4">
        <!-- CTA Button -->
        <a
          href="/book"
          class="nav-cta hidden sm:flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 hover:scale-105"
        >
          Reserve
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-toggle"
          class="mobile-toggle lg:hidden w-12 h-12 rounded-2xl flex items-center justify-center transition-all duration-300"
          aria-label="Toggle menu"
        >
          <div class="hamburger-icon w-6 h-5 relative">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </div>
        </button>
      </div>

    </div>
  </nav>
</header>

<!-- Fullscreen Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu-overlay">
  <div class="mobile-menu-bg"></div>

  <div class="mobile-menu-content">
    <!-- Close Button -->
    <button id="mobile-close" class="mobile-close" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Centered Navigation -->
    <nav class="mobile-nav">
      <a href="/menu" class="mobile-nav-link" data-index="0">
        <span class="mobile-nav-text">Menu</span>
        <span class="mobile-nav-line"></span>
      </a>
      <a href="/#pickleball" class="mobile-nav-link" data-index="1">
        <span class="mobile-nav-text">Pickleball</span>
        <span class="mobile-nav-line"></span>
      </a>
      <a href="/#events" class="mobile-nav-link" data-index="2">
        <span class="mobile-nav-text">Events</span>
        <span class="mobile-nav-line"></span>
      </a>
      <a href="/#hours-location" class="mobile-nav-link" data-index="3">
        <span class="mobile-nav-text">Hours</span>
        <span class="mobile-nav-line"></span>
      </a>
    </nav>

    <!-- CTA Section -->
    <div class="mobile-cta-section">
      <a href="/book" class="mobile-cta-primary">
        <span>Reserve</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Footer Info -->
    <div class="mobile-footer">
      <div class="mobile-social">
        <a href="https://instagram.com/blvdparkhtx" target="_blank" rel="noopener" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
          </svg>
        </a>
        <a href="https://facebook.com/blvdparkhtx" target="_blank" rel="noopener" aria-label="Facebook">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
      <p class="mobile-location">The Heights · Houston, TX</p>
    </div>
  </div>
</div>

<style>
  /* ===== NAVBAR BASE ===== */
  .navbar-2026 {
    --nav-bg: transparent;
    --nav-text: white;
    --nav-cta-bg: white;
    --nav-cta-text: #0F3D22;
    --blvd-green: #1A5F36;
    --blvd-green-bright: #22C55E;
    --blvd-gold: #C9A962;
  }

  .navbar-glass {
    background: var(--nav-bg);
    backdrop-filter: blur(0px);
  }

  .logo-text,
  .nav-link {
    color: var(--nav-text);
  }

  .nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-cta {
    background: var(--nav-cta-bg);
    color: var(--nav-cta-text);
  }

  /* Hamburger Button */
  .mobile-toggle {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    display: block;
    position: absolute;
    height: 2px;
    width: 100%;
    background: white;
    border-radius: 2px;
    transition: all 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6);
  }

  .hamburger-line.line-1 { top: 0; }
  .hamburger-line.line-2 { top: 50%; transform: translateY(-50%); }
  .hamburger-line.line-3 { bottom: 0; }

  /* Hamburger X Animation */
  .navbar-2026.menu-open .hamburger-line.line-1 {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .navbar-2026.menu-open .hamburger-line.line-2 {
    opacity: 0;
    transform: translateX(-20px);
  }

  .navbar-2026.menu-open .hamburger-line.line-3 {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* Scrolled State */
  .navbar-2026.scrolled {
    --nav-bg: rgba(15, 61, 34, 0.9);
  }

  .navbar-2026.scrolled .navbar-glass {
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Logo always white - works on both transparent (dark hero) and green scrolled states */
  .logo-img {
    filter: brightness(0) invert(1);
  }

  /* Nav Link Underline */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--blvd-gold);
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.19, 1, 0.22, 1);
    border-radius: 1px;
  }

  .nav-link:hover::after {
    width: calc(100% - 32px);
  }

  .nav-cta:hover {
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
  }

  .navbar-logo:hover .logo-mark {
    background: var(--blvd-green-bright) !important;
  }

  /* ===== FULLSCREEN MOBILE MENU ===== */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    overflow: hidden;
  }

  .mobile-menu-overlay.open {
    pointer-events: auto;
  }

  /* Background Layers */
  .mobile-menu-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0F3D22 0%, #0a2a17 50%, #071a0f 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .mobile-menu-overlay.open .mobile-menu-bg {
    opacity: 1;
  }

  /* Content Container */
  .mobile-menu-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 6rem 2rem 3rem;
    opacity: 0;
    transform: scale(0.95);
    transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mobile-menu-overlay.open .mobile-menu-content {
    opacity: 1;
    transform: scale(1);
  }

  /* Close Button */
  .mobile-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }

  .mobile-menu-overlay.open .mobile-close {
    opacity: 1;
    transform: rotate(0) scale(1);
    transition-delay: 0.3s;
  }

  .mobile-close:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: rotate(90deg);
  }

  /* Navigation Links */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .mobile-nav-link {
    position: relative;
    padding: 0.75rem 2rem;
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mobile-menu-overlay.open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu-overlay.open .mobile-nav-link[data-index="0"] { transition-delay: 0.15s; }
  .mobile-menu-overlay.open .mobile-nav-link[data-index="1"] { transition-delay: 0.2s; }
  .mobile-menu-overlay.open .mobile-nav-link[data-index="2"] { transition-delay: 0.25s; }
  .mobile-menu-overlay.open .mobile-nav-link[data-index="3"] { transition-delay: 0.3s; }

  .mobile-nav-text {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 600;
    color: white;
    letter-spacing: -0.02em;
    transition: all 0.3s ease;
  }

  .mobile-nav-link:hover .mobile-nav-text {
    color: var(--blvd-gold);
  }

  .mobile-nav-line {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    width: 0;
    height: 3px;
    background: var(--blvd-green-bright);
    border-radius: 2px;
    transform: translateX(-50%);
    transition: width 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mobile-nav-link:hover .mobile-nav-line {
    width: 60%;
  }

  /* CTA Section */
  .mobile-cta-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 320px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mobile-menu-overlay.open .mobile-cta-section {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.4s;
  }

  .mobile-cta-primary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.125rem 2rem;
    background: white;
    color: #0F3D22;
    border-radius: 1rem;
    font-family: 'Clash Display', sans-serif;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .mobile-cta-primary:hover {
    background: var(--blvd-green-bright);
    color: white;
    transform: scale(1.02);
    box-shadow: 0 10px 40px rgba(34, 197, 94, 0.3);
  }

  .mobile-cta-secondary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 1rem;
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .mobile-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Footer */
  .mobile-footer {
    position: absolute;
    bottom: 2rem;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.6s ease;
  }

  .mobile-menu-overlay.open .mobile-footer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }

  .mobile-social {
    display: flex;
    gap: 1rem;
  }

  .mobile-social a {
    width: 3rem;
    height: 3rem;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .mobile-social a:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    transform: translateY(-3px);
  }

  .mobile-location {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Hide menu on large screens */
  @media (min-width: 1024px) {
    .mobile-menu-overlay {
      display: none;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1023px) {
    .mobile-nav-text {
      font-size: 3rem;
    }

    .mobile-cta-section {
      max-width: 400px;
    }

    .mobile-cta-primary,
    .mobile-cta-secondary {
      padding: 1.25rem 2.5rem;
    }
  }

  /* Small mobile */
  @media (max-height: 680px) {
    .mobile-menu-content {
      padding: 5rem 1.5rem 2rem;
    }

    .mobile-nav {
      gap: 0.25rem;
      margin-bottom: 2rem;
    }

    .mobile-nav-link {
      padding: 0.5rem 1.5rem;
    }

    .mobile-nav-text {
      font-size: 1.75rem;
    }

    .mobile-footer {
      bottom: 1.5rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var navbar = document.querySelector('.navbar-2026');
    var mobileToggle = document.getElementById('mobile-toggle');
    var mobileMenu = document.getElementById('mobile-menu');
    var mobileClose = document.getElementById('mobile-close');
    var mobileLinks = document.querySelectorAll('.mobile-nav-link');

    // Scroll detection
    function handleScroll() {
      if (window.scrollY > 50) {
        navbar && navbar.classList.add('scrolled');
      } else {
        navbar && navbar.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Open menu
    function openMenu() {
      navbar && navbar.classList.add('menu-open');
      mobileMenu && mobileMenu.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    // Close menu
    function closeMenu() {
      navbar && navbar.classList.remove('menu-open');
      mobileMenu && mobileMenu.classList.remove('open');
      document.body.style.overflow = '';
    }

    // Toggle handlers
    mobileToggle && mobileToggle.addEventListener('click', function() {
      if (mobileMenu && mobileMenu.classList.contains('open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileClose && mobileClose.addEventListener('click', closeMenu);

    // Close on link click
    mobileLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        closeMenu();
      });
    });

    // Close on CTA click
    var ctaLinks = document.querySelectorAll('.mobile-cta-primary, .mobile-cta-secondary');
    ctaLinks.forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });

    // Close on escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu && mobileMenu.classList.contains('open')) {
        closeMenu();
      }
    });
  });
</script>
