---
// NBA Finals Popup Modal Component
// Shows automatically on homepage load to promote the NBA Finals event
// Displays once per day (based on browser's local date) after 1 second delay
// 
// Testing: Add ?showpopup=true to URL to always show popup
// Example: http://localhost:3000/?showpopup=true
---

<div id="nba-finals-popup" class="modal-overlay">
  <div class="modal-content">
    <button class="modal-close" aria-label="Close modal">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <div class="modal-body">
      <!-- Left side - Flyer -->
      <div class="flyer-container">
        <img src="/images/nbafinals.jpg" alt="NBA Finals at BLVD Park" class="flyer-image">
      </div>
      
      <!-- Right side - Content -->
      <div class="content-container">
        <h2 class="main-title">
          MAKE BLVD PARK YOUR<br>
          NBA FINALS HQ
        </h2>
        
        <div class="deals-grid">
          <div class="deal-item">• $4 Sliders</div>
          <div class="deal-item">• $1 Wings</div>
          <div class="deal-item">• $5 Chips & Queso</div>
          <div class="deal-item">• $8 Cocktails</div>
          <div class="deal-item">• $8 Casamigos</div>
          <div class="deal-full">• Buckets: $20 Beer • $25 Seltzer</div>
        </div>
        
        <div class="button-container">
          <a href="/book" class="btn-reserve">RESERVE YOUR TABLE</a>
          <button class="btn-continue" onclick="document.getElementById('nba-finals-popup').classList.remove('show')">CONTINUE TO SITE</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  
  .modal-overlay.show {
    display: flex;
  }
  
  .modal-content {
    background-color: white;
    border: 8px solid #208245;
    border-radius: 12px;
    max-width: 750px;
    width: 100%;
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  
  .modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: white;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }
  
  .modal-close:hover {
    background: #208245;
    color: white;
    border-color: #208245;
  }
  
  .modal-body {
    display: flex;
    padding: 30px;
    gap: 30px;
    align-items: center;
  }
  
  .flyer-container {
    flex: 0 0 260px;
  }
  
  .flyer-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }
  
  .content-container {
    flex: 1;
    text-align: center;
  }
  
  .main-title {
    font-size: 24px;
    font-weight: 800;
    color: #208245;
    margin-bottom: 20px;
    line-height: 1.1;
    text-transform: uppercase;
  }
  
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 16px;
    margin: 0 0 24px 0;
    text-align: left;
  }
  
  .deal-item {
    font-size: 14px;
    color: #333;
    font-weight: 500;
  }
  
  .deal-full {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 14px;
    color: #333;
    font-weight: 500;
  }

  
  .button-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 220px;
    margin: 0 auto;
  }
  
  .btn-reserve,
  .btn-continue {
    padding: 12px 20px;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    border: none;
    text-align: center;
    width: 100%;
  }
  
  .btn-reserve {
    background: #208245;
    color: white;
  }
  
  .btn-reserve:hover {
    background: #0A4A25;
  }
  
  .btn-continue {
    background: white;
    color: #208245;
    border: 2px solid #208245;
  }
  
  .btn-continue:hover {
    background: #208245;
    color: white;
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .modal-content {
      max-width: 90%;
      width: 90%;
    }
    
    .modal-body {
      flex-direction: column;
      padding: 18px;
      gap: 18px;
    }
    
    .flyer-container {
      flex: none;
      width: 100%;
      max-width: 200px;
      margin: 0 auto;
    }
    
    .main-title {
      font-size: 18px;
    }
    
    .deals-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
    .deal-item {
      font-size: 12px;
    }
    
    .deal-full {
      font-size: 12px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const popup = document.getElementById('nba-finals-popup');
    const closeBtn = popup?.querySelector('.modal-close');
    
    // Check if popup has been shown today
    const lastShownDate = localStorage.getItem('nbaFinalsPopupLastShown');
    const today = new Date().toDateString();
    const shouldShowPopup = lastShownDate !== today;
    
    // Dev mode: Add ?showpopup=true to URL to always show popup for testing
    const urlParams = new URLSearchParams(window.location.search);
    const forceShow = urlParams.get('showpopup') === 'true';
    
    // Show popup after 1 second if not already shown today (or if forced)
    if (popup && (shouldShowPopup || forceShow)) {
      setTimeout(() => {
        popup.classList.add('show');
        // Only update the last shown date if not in force mode
        if (!forceShow) {
          localStorage.setItem('nbaFinalsPopupLastShown', today);
        }
      }, 1000); // Shows after 1 second
    }
    
    // Close handlers
    closeBtn?.addEventListener('click', () => {
      popup?.classList.remove('show');
    });
    
    // Close on overlay click
    popup?.addEventListener('click', (e) => {
      if (e.target === popup) {
        popup.classList.remove('show');
      }
    });
    
    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popup?.classList.contains('show')) {
        popup.classList.remove('show');
      }
    });
  });
</script>