---
// src/components/GalleryGrid.astro - Reusable gallery grid component
// Creates a responsive grid layout for displaying images with lightbox functionality

// Define the props interface for type checking
interface Props {
  images: any;       // Array of image objects (using 'any' to avoid type errors)
  columns: number;   // Number of grid columns
  gap?: string;      // Optional CSS gap class
}

// Extract props with defaults
const { images = [], columns, gap = "gap-4" } = Astro.props;

// Ensure images is always an array
const safeImages = Array.isArray(images) ? images : [];

// Calculate responsive column classes based on the requested columns
// This creates a responsive grid that adjusts to different screen sizes
const getColumnClasses = (cols: number) => {
  switch (cols) {
    case 3: return "grid-cols-2 sm:grid-cols-3 md:grid-cols-3";
    case 4: return "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4";
    case 5: return "grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5";
    case 6: return "grid-cols-1 sm:grid-cols-3 lg:grid-cols-6";
    default: return `grid-cols-1 sm:grid-cols-2 md:grid-cols-${Math.min(cols, 4)} lg:grid-cols-${cols}`;
  }
};

const columnClasses = getColumnClasses(columns);
---

<!-- Lightbox overlays (rendered once at the top) -->
{safeImages.map((image, index) => {
  const originalSrc = image.src;
  const lightboxId = `lightbox-${index}`;
  
  return (
    <div id={lightboxId} class="lightbox">
      <div class="lightbox-backdrop">
        <a href="#" class="lightbox-close-area"></a>
        <div class="lightbox-content">
          <a href="#" class="lightbox-close-btn">&times;</a>
          <img src={originalSrc} alt={image.alt} class="lightbox-image" />
        </div>
      </div>
    </div>
  );
})}

<!-- 
  Grid container with dynamic column and gap classes
  - columnClasses: Controls responsive column layout
  - gap: Controls spacing between grid items
-->
<div class={`grid ${columnClasses} ${gap}`}>
  {safeImages.length > 0 ? safeImages.map((image, index) => {
    // Create responsive image source
    const basePath = image.src.replace('.webp', '');
    const mediumSrc = `${basePath}-medium.webp`;
    const thumbSrc = `${basePath}-thumb.webp`;
    const originalSrc = image.src;
    const lightboxId = `lightbox-${index}`;
    
    return (
      <div class="overflow-hidden rounded-lg aspect-square">
        <a href={`#${lightboxId}`} class="block w-full h-full cursor-pointer">
          <img
            src={thumbSrc}
            srcset={`${thumbSrc} 400w, ${mediumSrc} 800w`}
            sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, (max-width: 1024px) 25vw, 20vw"
            alt={image.alt}
            width="400"
            height="400"
            class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-110"
            loading={index < 2 ? "eager" : "lazy"}
            fetchpriority={index < 1 ? "high" : "auto"}
            onerror={`this.src='${originalSrc}'; this.srcset='';`}
          />
        </a>
      </div>
    );
  }) : <p class="text-red-500 p-4">No images available to display</p>}
</div>

<style>
  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox:target {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .lightbox-close-area {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    text-align: center;
  }

  .lightbox-close-btn {
    position: absolute;
    top: -40px;
    right: 0;
    color: white;
    font-size: 30px;
    font-weight: bold;
    text-decoration: none;
    z-index: 10;
    transition: color 0.3s ease;
  }

  .lightbox-close-btn:hover {
    color: #ccc;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
  }



  /* Animation for content */
  .lightbox:target .lightbox-content {
    animation: lightboxIn 0.3s ease-out;
  }

  @keyframes lightboxIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
