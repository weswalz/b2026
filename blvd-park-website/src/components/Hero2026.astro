---
// src/components/Hero2026.astro
// 2026 Refresh - Cinematic hero with proper mobile video support
// Elevated social club aesthetic

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
---

<section id="home" class="hero-2026 relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Video/Image Background with FIXED mobile support -->
  <div class="absolute inset-0 z-0">
    <!-- Video for ALL devices - prioritize showing the video -->
    <video 
      id="hero-video"
      class="absolute inset-0 w-full h-full object-cover"
      autoplay 
      muted 
      loop 
      playsinline
      webkit-playsinline
      poster="/images/venue/venue-hero-tall.webp"
      data-cms-attr="poster:home.hero.poster_src"
    >
      <source src="/images/blvdhero.mp4" type="video/mp4" data-cms-attr="src:home.hero.video_src" />
    </video>
    
    <!-- Fallback static image (shown only if video fails) -->
    <div 
      id="hero-fallback"
      class="hidden absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/venue/venue-hero-tall.webp');"
      data-cms-bg-key="home.hero.fallback_src"
    ></div>
    
    <!-- Premium gradient overlay - darker for text legibility -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/80"></div>
    
    <!-- Subtle green accent glow -->
    <div class="absolute bottom-0 left-0 right-0 h-1/3 bg-gradient-to-t from-[#1A5F36]/20 to-transparent"></div>
    
    <!-- Film grain texture -->
    <div class="absolute inset-0 opacity-[0.04] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.8%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-5 sm:px-6 pt-20 pb-32 text-center">
    <!-- Location Tag -->
    <div class="hero-eyebrow opacity-0 mb-8">
        <span class="inline-flex items-center gap-3 text-[#C9A962] font-mono text-xs sm:text-sm tracking-[0.2em] uppercase">
          <span class="w-6 sm:w-10 h-px bg-[#C9A962]/60"></span>
        <span data-cms-key="home.hero.location">Houston, TX</span>
          <span class="w-6 sm:w-10 h-px bg-[#C9A962]/60"></span>
        </span>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-headline opacity-0 font-display font-bold mb-8">
      <span class="block text-3xl sm:text-4xl md:text-5xl text-white/80 tracking-wide mb-2" data-cms-key="home.hero.headline_top">The Heights'</span>
      <span class="block text-5xl sm:text-6xl md:text-7xl lg:text-8xl bg-gradient-to-r from-[#22C55E] via-[#4ADE80] to-[#22C55E] bg-clip-text text-transparent leading-[0.9] tracking-tight" data-cms-key="home.hero.headline_highlight">
        PLAYGROUND
      </span>
    </h1>
    
    <!-- Tagline with gold accent -->
    <p class="hero-tagline opacity-0 font-mono text-sm sm:text-base md:text-lg text-white/50 mb-12 tracking-[0.15em] uppercase" data-cms-key="home.hero.tagline_html" data-cms-html="true">
      <span class="text-[#C9A962]">Sports</span> · <span class="text-white/70">Social</span> · <span class="text-[#C9A962]">Scene</span>
    </p>
    
    <!-- CTAs - Refined pills -->
    <div class="hero-ctas opacity-0 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="/#events" 
        class="group relative w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#1A5F36] text-white font-display font-semibold text-base rounded-full overflow-hidden transition-all duration-500 hover:bg-[#22C55E] hover:shadow-[0_0_40px_rgba(34,197,94,0.3)]"
        data-cms-attr="href:home.hero.cta_primary.href"
      >
        <span class="relative z-10" data-cms-key="home.hero.cta_primary.label">Events</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      
      <a
        href="/menu"
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/5 backdrop-blur-md text-white font-display font-semibold text-base rounded-full border border-white/10 transition-all duration-500 hover:bg-white/10 hover:border-white/20"
        data-cms-attr="href:home.hero.cta_secondary.href"
      >
        <span data-cms-key="home.hero.cta_secondary.label">Menu</span>
        <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom Info Bar - Glassmorphism -->
  <div class="absolute bottom-0 left-0 right-0 z-10">
    <div class="hero-info-bar opacity-0 bg-black/40 backdrop-blur-xl border-t border-white/5">
      <div class="container mx-auto px-4 sm:px-6 py-4 sm:py-5">
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:gap-x-10 text-xs sm:text-sm">
          <!-- Location -->
          <div class="flex items-center gap-2 text-white/60">
            <svg class="w-4 h-4 text-[#22C55E]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <span class="font-mono" data-cms-key="home.hero.info_location">Heights, HTX</span>
          </div>
          
          <!-- Open Status -->
          <div class="flex items-center gap-2 text-white/60">
            <span class="relative flex h-2 w-2">
              <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75"></span>
              <span id="status-dot" class="relative inline-flex rounded-full h-2 w-2 bg-[#22C55E]"></span>
            </span>
            <span id="hero-status" class="font-mono" data-cms-key="global.status.loading">Loading...</span>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-28 sm:bottom-24 left-1/2 -translate-x-1/2 z-10 hero-scroll opacity-0">
    <a href="#value-props" class="flex flex-col items-center gap-2 text-white/40 hover:text-white/80 transition-colors">
      <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero-2026 {
    min-height: 100vh;
    min-height: 100dvh;
  }
  
  /* Ensure video covers properly on all devices */
  #hero-video {
    object-fit: cover;
    object-position: center;
  }
  
  /* Hero animations */
  .hero-2026 .animate-in {
    animation: heroReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Staggered animation delays */
  .hero-eyebrow.animate-in { animation-delay: 0.1s; }
  .hero-headline.animate-in { animation-delay: 0.3s; }
  .hero-tagline.animate-in { animation-delay: 0.5s; }
  .hero-ctas.animate-in { animation-delay: 0.7s; }
  .hero-info-bar.animate-in { animation-delay: 0.9s; }
  .hero-scroll.animate-in { animation-delay: 1.1s; }
  
  /* Gradient text shimmer effect on hover */
  .hero-headline span:nth-child(3) {
    background-size: 200% auto;
    animation: shimmer 3s linear infinite;
  }
  
  @keyframes shimmer {
    to {
      background-position: 200% center;
    }
  }
</style>

<script define:vars={{ apiUrl }}>
  const getContentValue = (key, fallback) => (window.__blvdContent && window.__blvdContent[key]) || fallback;
  const escapeHtml = (value) => {
    if (!value) return '';
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\"/g, '&quot;')
      .replace(/'/g, '&#39;');
  };

  const parseTimeToMinutes = (value) => {
    if (!value) return null;
    const [hoursRaw, minutesRaw] = value.split(':');
    if (hoursRaw === undefined || minutesRaw === undefined) return null;
    const hours = Number(hoursRaw);
    const minutes = Number(minutesRaw);
    if (Number.isNaN(hours) || Number.isNaN(minutes)) return null;
    return (hours * 60) + minutes;
  };

  const formatMinutesToTime = (totalMinutes, options = {}) => {
    const { uppercase = false, alwaysShowMinutes = false } = options;
    const normalized = totalMinutes === 1440 ? 0 : totalMinutes;
    if (normalized === 0) {
      const suffix = uppercase ? 'AM' : 'am';
      const minuteLabel = alwaysShowMinutes ? ':00' : '';
      return `12${minuteLabel}${suffix}`;
    }
    const hour24 = Math.floor(normalized / 60) % 24;
    const minute = normalized % 60;
    const suffix = hour24 >= 12 ? (uppercase ? 'PM' : 'pm') : (uppercase ? 'AM' : 'am');
    let hour12 = hour24 % 12;
    if (hour12 === 0) hour12 = 12;
    const showMinutes = alwaysShowMinutes || minute !== 0;
    const minuteLabel = showMinutes ? `:${minute.toString().padStart(2, '0')}` : '';
    return `${hour12}${minuteLabel}${suffix}`;
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Trigger entrance animations
    const elements = [
      '.hero-eyebrow',
      '.hero-headline', 
      '.hero-tagline',
      '.hero-ctas',
      '.hero-info-bar',
      '.hero-scroll'
    ];
    
    elements.forEach(selector => {
      const el = document.querySelector(selector);
      if (el) el.classList.add('animate-in');
    });
    
    // Video fallback handling
    const video = document.getElementById('hero-video');
    const fallback = document.getElementById('hero-fallback');
    
    if (video) {
      video.addEventListener('error', () => {
        if (fallback) {
          video.classList.add('hidden');
          fallback.classList.remove('hidden');
        }
      });
      
      // Force video play on mobile (iOS workaround)
      video.play().catch(() => {
        // If autoplay fails, show fallback
        if (fallback) {
          fallback.classList.remove('hidden');
        }
      });
    }
    
    // Update open/closed status
    loadSchedule().then(updateStatus);

    document.addEventListener('blvd:hours', () => {
      window.__blvdHoursSchedule = null;
      loadSchedule().then(updateStatus);
    });

    if (window.__blvdSubscribeContent) {
      window.__blvdSubscribeContent(() => {
        updateStatus(window.__blvdHoursSchedule);
      });
    }
  });
  
  const isCrossMidnight = (entry) => entry.close < entry.open;

  async function loadSchedule() {
    if (window.__blvdHoursSchedule) return window.__blvdHoursSchedule;
    try {
      const res = await fetch(`${apiUrl}/api/hours`);
      if (!res.ok) throw new Error('Failed to fetch hours');
      const hours = await res.json();
      if (!Array.isArray(hours) || hours.length === 0) throw new Error('No hours');

      const schedule = Array.from({ length: 7 }, () => ({
        open: 0,
        close: 0,
        isClosed: true,
      }));

      hours.forEach((entry) => {
        const open = parseTimeToMinutes(entry.openTime);
        const close = parseTimeToMinutes(entry.closeTime);
        schedule[entry.dayOfWeek] = {
          open: open ?? 0,
          close: close ?? 0,
          isClosed: Boolean(entry.isClosed) || open === null || close === null,
        };
      });

      window.__blvdHoursSchedule = schedule;
      return schedule;
    } catch (_error) {
      return null;
    }
  }

  function updateStatus(schedule) {
    const statusEl = document.getElementById('hero-status');
    const pingEl = document.getElementById('status-ping');
    const dotEl = document.getElementById('status-dot');
    if (!statusEl) return;

    const openLabel = getContentValue('global.status.open_label', 'Open');
    const closedLabel = getContentValue('global.status.closed_label', 'Closed');
    const openUntilLabel = getContentValue('global.status.open_until_label', 'til');
    const unavailableLabel = getContentValue('global.status.hours_unavailable', 'Hours unavailable');

    if (!Array.isArray(schedule)) {
      statusEl.innerHTML = `<span class="text-[#C9A962]">${escapeHtml(unavailableLabel)}</span>`;
      if (pingEl) pingEl.classList.add('hidden');
      if (dotEl) dotEl.style.backgroundColor = '#C9A962';
      return;
    }
    
    const now = new Date();
    const day = now.getDay();
    const minutes = now.getHours() * 60 + now.getMinutes();
    
    const today = schedule[day];
    const yesterday = schedule[(day + 6) % 7];
    if (!today || !yesterday) {
      statusEl.innerHTML = `<span class="text-[#C9A962]">${escapeHtml(unavailableLabel)}</span>`;
      if (pingEl) pingEl.classList.add('hidden');
      if (dotEl) dotEl.style.backgroundColor = '#C9A962';
      return;
    }
    
    let isOpen = false;
    let closeMinutes = null;
    
    if (!yesterday.isClosed && isCrossMidnight(yesterday) && minutes < yesterday.close) {
      isOpen = true;
      closeMinutes = yesterday.close;
    } else if (!today.isClosed && !isCrossMidnight(today)) {
      if (minutes >= today.open && minutes < today.close) {
        isOpen = true;
        closeMinutes = today.close;
      }
    } else if (!today.isClosed && minutes >= today.open) {
      isOpen = true;
      closeMinutes = today.close;
    }
    
    if (isOpen) {
      const closeTimeLabel = closeMinutes !== null ? formatMinutesToTime(closeMinutes) : '';
      statusEl.innerHTML = `<span class="text-[#22C55E]">${escapeHtml(openLabel)}</span> ${escapeHtml(openUntilLabel)} ${escapeHtml(closeTimeLabel)}`;
      if (pingEl) pingEl.classList.remove('hidden');
      if (dotEl) dotEl.style.backgroundColor = '#22C55E';
    } else {
      statusEl.innerHTML = `<span class="text-[#C9A962]">${escapeHtml(closedLabel)}</span>`;
      if (pingEl) pingEl.classList.add('hidden');
      if (dotEl) dotEl.style.backgroundColor = '#C9A962';
    }
  }
</script>
