---
// src/components/cms/CallToAction.astro
// Builder module: full-width dark-green CTA band with up to two pill buttons,
// matching the homepage hero CTA styling.

export interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = '',
  subtitle = '',
  primaryLabel = '',
  primaryHref = '',
  secondaryLabel = '',
  secondaryHref = '',
} = Astro.props;
---

<section class="section-padding" style="background: linear-gradient(180deg, var(--blvd-dark-green, #0f3d22), var(--blvd-green-dark, #0f3d22));">
  <div class="max-w-3xl mx-auto px-6 text-center">
    {title && (
      <h2 class="font-display font-bold text-white text-3xl sm:text-4xl md:text-5xl leading-tight">{title}</h2>
    )}
    {subtitle && (
      <p class="mt-5 font-mono text-sm sm:text-base text-white/60 tracking-[0.08em] uppercase">{subtitle}</p>
    )}
    {(primaryLabel || secondaryLabel) && (
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        {primaryLabel && primaryHref && (
          <a
            href={primaryHref}
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#22C55E] text-[#0F3D22] font-display font-semibold text-base rounded-full transition-all duration-500 hover:bg-white hover:shadow-[0_0_40px_rgba(34,197,94,0.3)]"
          >
            <span>{primaryLabel}</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
        {secondaryLabel && secondaryHref && (
          <a
            href={secondaryHref}
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/5 backdrop-blur-md text-white font-display font-semibold text-base rounded-full border border-white/10 transition-all duration-500 hover:bg-white/10 hover:border-white/20"
          >
            <span>{secondaryLabel}</span>
            <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        )}
      </div>
    )}
  </div>
</section>
