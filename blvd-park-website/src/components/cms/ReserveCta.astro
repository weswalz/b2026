---
// src/components/cms/ReserveCta.astro
// Builder module: VIP table reservation band, styled after the site's
// reservation CTAs (green gradient, bold display type, bright pill button).

export interface Props {
  title?: string;
  subtitle?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title = 'Reserve Your Table',
  subtitle = '',
  buttonLabel = 'Book Now',
  buttonHref = '/book',
} = Astro.props;
---

<section class="section-padding" style="background: linear-gradient(135deg, var(--blvd-green-dark, #0f3d22) 0%, var(--blvd-green, #1a5f36) 100%);">
  <div class="max-w-3xl mx-auto px-6 text-center">
    {title && (
      <h2 class="font-display font-bold text-white text-3xl sm:text-4xl md:text-5xl leading-tight">{title}</h2>
    )}
    {subtitle && (
      <p class="mt-5 font-mono text-sm sm:text-base text-white/70 tracking-[0.08em] uppercase">{subtitle}</p>
    )}
    <div class="mt-10">
      <a
        href={buttonHref}
        class="group inline-flex items-center justify-center gap-2 px-10 py-4 bg-[#22C55E] text-[#0F3D22] font-display font-semibold text-base rounded-full transition-all duration-500 hover:bg-white hover:shadow-[0_0_40px_rgba(34,197,94,0.4)]"
      >
        <span>{buttonLabel}</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
