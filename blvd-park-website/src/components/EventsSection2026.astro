---
// src/components/EventsSection2026.astro
// 2026 Redesign - Modern events with featured hero and accordion

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
---

<section id="events" class="events-2026 relative section-padding overflow-hidden bg-gradient-to-b from-blvd-green-dark via-blvd-green to-blvd-green-dark">

  <!-- Ambient effects -->
  <div class="absolute top-1/4 left-0 w-96 h-96 rounded-full opacity-20 blur-3xl bg-blvd-green-bright"></div>
  <div class="absolute bottom-1/4 right-0 w-80 h-80 rounded-full opacity-15 blur-3xl bg-blvd-gold"></div>

  <!-- Subtle pattern -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="container mx-auto px-6 relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="eyebrow inline-block mb-4 px-4 py-2 rounded-full border border-blvd-gold/30 bg-blvd-gold/10">
        What's Happening
      </span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight">
        BLVD Events
      </h2>
    </div>
    
    <!-- Featured Event Card -->
    <div class="featured-event mb-12 max-w-4xl mx-auto">
      <div class="relative glass-card rounded-3xl overflow-hidden">

        <div class="grid md:grid-cols-2">
          <!-- Event Image -->
          <div class="relative h-64 md:h-80">
            <div
              id="featured-image"
              role="img"
              aria-label="Event image"
              class="absolute inset-0 w-full h-full bg-gradient-to-br from-blvd-green-dark via-blvd-green to-blvd-green-bright/40"
            ></div>
            <div class="absolute inset-0 md:hidden bg-gradient-to-t from-blvd-green-dark to-transparent"></div>
            <div class="absolute inset-0 hidden md:block bg-gradient-to-r from-transparent via-transparent to-blvd-green-dark/95"></div>

            <!-- Featured Badge -->
            <div class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-bold bg-blvd-gold text-blvd-green-dark">
              FEATURED
            </div>
          </div>

          <!-- Event Details -->
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div id="featured-meta" class="font-mono text-sm mb-3 text-blvd-gold">
              Loading events...
            </div>
            <h3 id="featured-title" class="font-display text-2xl md:text-3xl font-bold text-white mb-4">
              Upcoming Events
            </h3>
            <p id="featured-description" class="mb-6 text-white/70 font-body">
              Check back soon for the latest events and specials.
            </p>
            <a
              href="/book2026"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm transition-all duration-300 hover:scale-105 self-start bg-white text-blvd-green-dark hover:shadow-lg"
            >
              Reserve Your Spot
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
        
      </div>
    </div>
    
    <!-- Events Accordion -->
    <div class="events-accordion max-w-3xl mx-auto space-y-3" id="events-accordion">
      <div class="text-center text-white/50 py-10">
        Loading events...
      </div>
    </div>

    <!-- View All CTA -->
    <div class="text-center mt-12">
      <a
        href="/book2026"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold transition-all duration-300 hover:scale-105 bg-white/10 text-white border border-white/20 hover:bg-white/15"
      >
        Book Your Event
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<style>
  .event-item.active .accordion-icon {
    transform: rotate(180deg);
  }
  
  .event-item.active .event-content {
    max-height: 200px;
  }
  
  .event-item.active {
    background: rgba(255,255,255,0.08) !important;
  }
</style>

<script define:vars={{ apiUrl }}>
  const toImageUrl = (value) => {
    if (!value) return '';
    if (value.startsWith('http')) return value;
    if (value.startsWith('/images/')) return `${window.location.origin}${value}`;
    if (value.startsWith('/uploads/')) return `${apiUrl}${value}`;
    return value;
  };

  const escapeHtml = (value) => {
    if (!value) return '';
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\"/g, '&quot;')
      .replace(/'/g, '&#39;');
  };

  const bindAccordion = () => {
    const triggers = document.querySelectorAll('.event-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const parent = trigger.closest('.event-item');
        const isActive = parent.classList.contains('active');

        document.querySelectorAll('.event-item').forEach(item => {
          item.classList.remove('active');
        });

        if (!isActive) {
          parent.classList.add('active');
        }
      });
    });

    const firstItem = document.querySelector('.event-item');
    if (firstItem) firstItem.classList.add('active');
  };

  const renderAccordion = (items) => {
    const accordion = document.getElementById('events-accordion');
    if (!accordion) return;

    accordion.innerHTML = items.map((event, index) => `
      <div class="event-item glass-card rounded-2xl overflow-hidden transition-all duration-300">
        <button
          class="event-trigger w-full px-6 py-5 flex items-center justify-between text-left transition-colors duration-300 hover:bg-white/5"
          data-index="${index}"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-blvd-gold/10">
              <svg class="w-5 h-5 text-blvd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-display font-semibold text-white text-lg">${escapeHtml(event.title)}</h4>
              <span class="font-mono text-xs text-white/50">${escapeHtml(event.date)} • ${escapeHtml(event.time)}</span>
            </div>
          </div>
          <svg class="accordion-icon w-5 h-5 transition-transform duration-300 flex-shrink-0 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <div class="event-content overflow-hidden max-h-0 transition-all duration-300">
          <div class="px-6 pb-6 pt-2">
            <p class="mb-4 font-body text-white/60">
              ${escapeHtml(event.description)}
            </p>
            <a
              href="/book2026"
              class="inline-flex items-center gap-2 text-sm font-medium transition-colors duration-300 text-blvd-green-bright hover:text-white"
            >
              Reserve a Table
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    `).join('');

    bindAccordion();
  };

  const renderFeatured = (event) => {
    const image = document.getElementById('featured-image');
    const meta = document.getElementById('featured-meta');
    const title = document.getElementById('featured-title');
    const description = document.getElementById('featured-description');

    if (image) {
      const imageUrl = toImageUrl(event.image);
      image.style.backgroundImage = imageUrl ? `url(${imageUrl})` : '';
      image.style.backgroundSize = 'cover';
      image.style.backgroundPosition = 'center';
      image.setAttribute('aria-label', event.title);
    }
    if (meta) meta.textContent = `${event.date} • ${event.time}`;
    if (title) title.textContent = event.title;
    if (description) description.textContent = event.description;
  };

  async function loadEvents() {
    try {
      const res = await fetch(`${apiUrl}/api/events`);
      if (!res.ok) throw new Error('Failed to fetch events');
      const events = await res.json();
      if (!Array.isArray(events) || events.length === 0) return null;
      return events;
    } catch (_error) {
      return null;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    bindAccordion();

    loadEvents().then((events) => {
      const accordion = document.getElementById('events-accordion');
      if (!Array.isArray(events) || events.length === 0) {
        if (accordion) {
          accordion.innerHTML = '<div class="text-center text-white/50 py-10">No events available right now.</div>';
        }
        return;
      }
      renderFeatured(events[0]);
      renderAccordion(events);
    });
  });
</script>
