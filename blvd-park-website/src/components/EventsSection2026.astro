---
// src/components/EventsSection2026.astro
// 2026 Redesign - Modern events with featured hero and accordion

const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";
---

<section
  id="events"
  class="events-2026 relative section-padding overflow-hidden bg-gradient-to-b from-blvd-charcoal via-blvd-charcoal-light to-blvd-charcoal"
>
  <!-- Ambient effects -->
  <div
    class="absolute top-1/4 left-0 w-96 h-96 rounded-full opacity-10 blur-3xl bg-blvd-green"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-0 w-80 h-80 rounded-full opacity-10 blur-3xl bg-blvd-gold"
  >
  </div>

  <!-- Subtle pattern -->
  <div
    class="absolute inset-0 opacity-[0.02]"
    style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span
        class="eyebrow inline-block mb-4 px-4 py-2 rounded-full border border-blvd-gold/30 bg-blvd-gold/10"
        data-cms-key="home.events.eyebrow"
      >
        What's Happening
      </span>
      <h2
        class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight"
        data-cms-key="home.events.headline"
      >
        BLVD Events
      </h2>
    </div>

    <!-- Featured Event Card -->
    <div class="featured-event mb-12 max-w-4xl mx-auto">
      <div class="relative glass-card rounded-3xl overflow-hidden">
        <div class="grid md:grid-cols-2">
          <!-- Event Image -->
          <div class="relative aspect-[4/5]">
            <div
              id="featured-image"
              role="img"
              aria-label="Event image"
              class="absolute inset-0 w-full h-full bg-blvd-charcoal overflow-hidden"
            >
            </div>
            <div
              class="absolute inset-0 md:hidden bg-gradient-to-t from-blvd-charcoal/80 via-transparent to-transparent pointer-events-none"
            >
            </div>

            <!-- Featured Badge -->
            <div
              class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-bold bg-blvd-gold text-blvd-green-dark"
              data-cms-key="home.events.featured_label"
            >
              FEATURED
            </div>
          </div>

          <!-- Event Details -->
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div
              id="featured-meta"
              class="font-mono text-sm mb-3 text-blvd-gold"
              data-cms-key="home.events.loading_label"
            >
              Loading events...
            </div>
            <h3
              id="featured-title"
              class="font-display text-2xl md:text-3xl font-bold text-white mb-4"
              data-cms-key="home.events.featured_title_fallback"
            >
              Upcoming Events
            </h3>
            <p
              id="featured-description"
              class="mb-6 text-white/70 font-body"
              data-cms-key="home.events.featured_description_fallback"
            >
              Check back soon for the latest events and specials.
            </p>
            <a
              href="/book"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm transition-all duration-300 hover:scale-105 self-start bg-white text-blvd-green-dark hover:shadow-lg"
              data-cms-attr="href:home.events.featured_cta.href"
            >
              <span data-cms-key="home.events.featured_cta.label"
                >Reserve Your Spot</span
              >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Event Cards -->
    <div
      class="events-list max-w-4xl mx-auto space-y-4"
      id="events-accordion"
    >
      <div class="text-center text-white/50 py-10">
        <span data-cms-key="home.events.loading_label">Loading events...</span>
      </div>
    </div>

    <!-- View All CTA -->
    <div class="text-center mt-12">
      <a
        href="/book"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold transition-all duration-300 hover:scale-105 bg-white/10 text-white border border-white/20 hover:bg-white/15"
        data-cms-attr="href:home.events.cta.href"
      >
        <span data-cms-key="home.events.cta.label">Book Your Event</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Featured flyer: portrait frame, image fills edge-to-edge. */
  #featured-image {
    position: absolute;
    inset: 0;
    background-image: var(--featured-image-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Event card flyer — :global() because elements are injected via innerHTML
     and won't carry the Astro scoped data attribute */
  :global(.event-card-flyer) {
    position: relative;
    overflow: hidden;
    background-image: var(--card-flyer-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>

<script define:vars={{ apiUrl }}>
  const getContentValue = (key, fallback) =>
    (window.__blvdContent && window.__blvdContent[key]) || fallback;

  const toImageUrl = (value) => {
    if (!value) return "";
    if (value.startsWith("http")) return value;
    if (value.startsWith("/images/"))
      return `${window.location.origin}${value}`;
    if (value.startsWith("/uploads/")) return `${apiUrl}${value}`;
    return value;
  };

  const escapeHtml = (value) => {
    if (!value) return "";
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\"/g, "&quot;")
      .replace(/'/g, "&#39;");
  };

  const formatTime = (value) => {
    if (!value) return "";
    const [h, m] = value.split(":").map(Number);
    if (Number.isNaN(h) || Number.isNaN(m)) return value;
    const period = h >= 12 ? "PM" : "AM";
    const hour12 = h % 12 === 0 ? 12 : h % 12;
    const minutes = m === 0 ? "" : `:${String(m).padStart(2, "0")}`;
    return `${hour12}${minutes} ${period}`;
  };

  const formatDate = (value) => {
    if (!value) return "";
    const parts = value.split("-").map(Number);
    if (parts.length !== 3) return value;
    const [y, mo, d] = parts;
    const date = new Date(y, mo - 1, d);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleDateString("en-US", {
      weekday: "short",
      month: "short",
      day: "numeric",
    });
  };

  const renderEventCards = (items) => {
    const container = document.getElementById("events-accordion");
    if (!container) return;

    const itemCtaLabel = escapeHtml(
      getContentValue("home.events.item_cta.label", "Reserve a Table"),
    );
    const itemCtaHref = escapeHtml(
      getContentValue("home.events.item_cta.href", "/book"),
    );

    container.innerHTML = items
      .map((event) => {
        const imgUrl = toImageUrl(event.image);
        const safeUrl = imgUrl ? imgUrl.replace(/'/g, "%27") : "";

        const flyerSection = safeUrl
          ? `<div
               class="event-card-flyer flex-shrink-0 w-full md:w-64 aspect-[4/5]"
               style="--card-flyer-url: url('${safeUrl}');"
             ></div>`
          : `<div class="flex-shrink-0 w-full md:w-64 aspect-[4/5] flex items-center justify-center bg-white/5">
               <svg class="w-10 h-10 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
               </svg>
             </div>`;

        return `
          <div class="glass-card rounded-2xl overflow-hidden flex flex-col md:flex-row">
            ${flyerSection}
            <div class="flex flex-col justify-center px-6 py-6 flex-1">
              <span class="font-mono text-xs text-blvd-gold mb-2">${escapeHtml(formatDate(event.date))} • ${escapeHtml(formatTime(event.time))}</span>
              <h4 class="font-display font-semibold text-white text-xl mb-3">${escapeHtml(event.title)}</h4>
              ${event.description ? `<p class="font-body text-white/60 text-sm mb-5 leading-relaxed">${escapeHtml(event.description)}</p>` : ""}
              <a
                href="${itemCtaHref}"
                class="inline-flex items-center gap-2 text-sm font-semibold px-5 py-2 rounded-full self-start transition-colors duration-300 bg-white/10 text-white hover:bg-white/15 border border-white/10"
              >
                ${itemCtaLabel}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        `;
      })
      .join("");
  };

  const renderFeatured = (event) => {
    const image = document.getElementById("featured-image");
    const meta = document.getElementById("featured-meta");
    const title = document.getElementById("featured-title");
    const description = document.getElementById("featured-description");

    if (image) {
      const imageUrl = toImageUrl(event.image);
      // Keep the full flyer visible (contain), but avoid "empty bars" by filling
      // the container with a blurred/zoomed version behind it (CSS pseudo-elements).
      image.style.setProperty(
        "--featured-image-url",
        imageUrl ? `url(${JSON.stringify(imageUrl)})` : "none",
      );
      image.setAttribute("aria-label", event.title);
    }
    if (meta) meta.textContent = `${formatDate(event.date)} • ${formatTime(event.time)}`;
    if (title) title.textContent = event.title;
    if (description) description.textContent = event.description;
  };

  async function loadEvents() {
    try {
      const res = await fetch(`${apiUrl}/api/events`);
      if (!res.ok) throw new Error("Failed to fetch events");
      const events = await res.json();
      if (!Array.isArray(events) || events.length === 0) return null;
      return events;
    } catch (_error) {
      return null;
    }
  }

  let cachedEvents = [];

  const refreshEvents = async () => {
    const section = document.getElementById("events");
    if (section) section.classList.remove("hidden");

    const events = await loadEvents();
    if (!Array.isArray(events) || events.length === 0) {
      return;
    }
    cachedEvents = events;
    renderFeatured(events[0]);
    const restCards = events.slice(1);
    const list = document.querySelector(".events-list");
    if (list) list.classList.toggle("hidden", restCards.length === 0);
    renderEventCards(restCards);
  };

  document.addEventListener("DOMContentLoaded", () => {
    refreshEvents();
    document.addEventListener("blvd:events", refreshEvents);

    if (window.__blvdSubscribeContent) {
      window.__blvdSubscribeContent(() => {
        if (cachedEvents.length > 0) {
          renderFeatured(cachedEvents[0]);
          renderEventCards(cachedEvents.slice(1));
        }
      });
    }
  });
</script>
