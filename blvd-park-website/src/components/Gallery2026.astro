---
// src/components/Gallery2026.astro
// 2026 Refresh - Instagram-style masonry gallery
// Horizontal scroll on mobile, grid on desktop - sleek and social

const gallerySlots = Array.from({ length: 12 }, (_, index) => index);
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
---

<section id="blvd-gallery" class="gallery-2026 section-padding bg-dark-base relative overflow-hidden">
  <!-- Ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] opacity-10 pointer-events-none bg-gradient-radial from-blvd-green/50 to-transparent"></div>

  <div class="relative z-10">
    <!-- Section Header -->
    <div class="container mx-auto px-5 sm:px-6 text-center mb-10 md:mb-14">
      <span class="gallery-header eyebrow inline-block mb-4 opacity-0">
        @blvdparkhtx
      </span>
      <h2 class="gallery-headline font-display font-bold text-4xl sm:text-5xl md:text-6xl text-white opacity-0 tracking-tight">
        It's a <span class="text-blvd-green-bright">BLVD</span> Thing
      </h2>
      <p id="gallery-status" class="mt-4 text-sm text-white/50">
        Loading gallery...
      </p>
    </div>
    
    <!-- Mobile: Horizontal scroll gallery -->
    <div class="md:hidden overflow-x-auto scrollbar-hide px-4 pb-4">
      <div class="flex gap-3 w-max">
        {gallerySlots.map((index) => (
          <button
            class="gallery-thumb-mobile relative flex-shrink-0 w-64 aspect-[4/5] overflow-hidden rounded-2xl cursor-pointer group opacity-0"
            data-index={index}
            style={`animation-delay: ${index * 0.05}s`}
          >
            <img 
              src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 group-active:scale-105"
              loading={index < 4 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </button>
        ))}
      </div>
    </div>
    
    <!-- Desktop: Masonry-style grid -->
    <div class="hidden md:block container mx-auto px-6">
      <div class="grid grid-cols-4 gap-3 lg:gap-4">
        {/* Row 1: Large left, 2 small right */}
        <div class="col-span-2 row-span-2">
          <button class="gallery-thumb relative w-full h-full aspect-square overflow-hidden rounded-2xl cursor-pointer group opacity-0" data-index="0">
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
              <div class="w-14 h-14 rounded-full bg-white/90 backdrop-blur flex items-center justify-center">
                <svg class="w-6 h-6 text-blvd-charcoal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                </svg>
              </div>
            </div>
          </button>
        </div>
        {[1, 2, 3, 4].map(i => (
          <button class="gallery-thumb relative aspect-square overflow-hidden rounded-2xl cursor-pointer group opacity-0" data-index={i} style={`animation-delay: ${i * 0.1}s`}>
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="eager"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-blvd-green/20 transition-all duration-300"></div>
          </button>
        ))}

        {/* Row 2: 4 equal */}
        {[5, 6, 7, 8].map(i => (
          <button class="gallery-thumb relative aspect-square overflow-hidden rounded-2xl cursor-pointer group opacity-0" data-index={i} style={`animation-delay: ${i * 0.1}s`}>
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-blvd-green/20 transition-all duration-300"></div>
          </button>
        ))}

        {/* Row 3: Wide left, tall right */}
        <div class="col-span-2">
          <button class="gallery-thumb relative w-full aspect-[2/1] overflow-hidden rounded-2xl cursor-pointer group opacity-0" data-index="9" style="animation-delay: 0.9s">
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-blvd-green/20 transition-all duration-300"></div>
          </button>
        </div>
        {[10, 11].map(i => (
          <button class="gallery-thumb relative aspect-square overflow-hidden rounded-2xl cursor-pointer group opacity-0" data-index={i} style={`animation-delay: ${i * 0.1}s`}>
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-blvd-green/20 transition-all duration-300"></div>
          </button>
        ))}
      </div>
    </div>
    
    <!-- View All / Instagram CTA -->
    <div class="text-center mt-10 md:mt-14 px-5">
      <a 
        href="https://instagram.com/blvdparkhtx" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-white/5 backdrop-blur-md text-white font-display font-semibold rounded-full border border-white/10 transition-all duration-300 hover:bg-white/10 hover:border-white/20 hover:scale-105"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Follow @blvdparkhtx
      </a>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div id="gallery-lightbox" class="fixed inset-0 z-[200] hidden">
  <div class="lightbox-backdrop absolute inset-0 bg-black/95 backdrop-blur-xl"></div>
  
  <div class="relative z-10 w-full h-full flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between p-4 md:p-6">
      <div class="font-mono text-white/50 text-sm">
        <span id="lightbox-counter">0</span> / <span id="lightbox-total">0</span>
      </div>
      <button id="lightbox-close" class="p-2 text-white/50 hover:text-white transition-colors">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    
    <!-- Main Image -->
    <div class="flex-1 flex items-center justify-center px-4 md:px-16 relative">
      <button id="lightbox-prev" class="absolute left-4 md:left-8 p-3 bg-white/5 hover:bg-white/10 rounded-full text-white/70 hover:text-white transition-all">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-lg"/>
      
      <button id="lightbox-next" class="absolute right-4 md:right-8 p-3 bg-white/5 hover:bg-white/10 rounded-full text-white/70 hover:text-white transition-all">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
    
    <!-- Thumbnail strip -->
    <div class="p-4 md:p-6">
      <div id="lightbox-thumbs" class="flex gap-2 overflow-x-auto scrollbar-hide justify-center"></div>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  .gallery-header,
  .gallery-headline {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .gallery-header { animation-delay: 0.1s; }
  .gallery-headline { animation-delay: 0.2s; }
  
  .gallery-thumb,
  .gallery-thumb-mobile {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .lightbox-thumb.active {
    opacity: 1;
    transform: scale(1.1);
  }
  
  #gallery-lightbox {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #gallery-lightbox.open {
    opacity: 1;
  }
</style>

<script define:vars={{ apiUrl }}>
  let images = [];
  let currentIndex = 0;
  
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById('lightbox-image');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxTotal = document.getElementById('lightbox-total');
  const lightboxThumbsContainer = document.getElementById('lightbox-thumbs');
  const statusEl = document.getElementById('gallery-status');
  let lightboxThumbs = [];

  const toImageUrl = (value) => {
    if (!value) return value;
    if (value.startsWith('http')) return value;
    if (value.startsWith('/images/')) return `${window.location.origin}${value}`;
    if (value.startsWith('/uploads/')) return `${apiUrl}${value}`;
    return value;
  };

  const applyImages = () => {
    const mobileThumbs = document.querySelectorAll('.gallery-thumb-mobile');
    const gridThumbs = document.querySelectorAll('.gallery-thumb');

    mobileThumbs.forEach((btn, index) => {
      const image = images[index];
      if (!image) {
        btn.classList.add('hidden');
        return;
      }
      btn.classList.remove('hidden');
      btn.dataset.index = index.toString();
      const img = btn.querySelector('img');
      if (img) {
        img.src = image.url;
        img.alt = image.alt;
      }
    });

    gridThumbs.forEach((btn, index) => {
      const image = images[index];
      if (!image) {
        btn.classList.add('hidden');
        return;
      }
      btn.classList.remove('hidden');
      btn.dataset.index = index.toString();
      const img = btn.querySelector('img');
      if (img) {
        img.src = image.url;
        img.alt = image.alt;
      }
    });

    if (lightboxTotal) {
      lightboxTotal.textContent = images.length.toString();
    }
    if (lightboxCounter && images.length === 0) {
      lightboxCounter.textContent = '0';
    }
  };

  const renderLightboxThumbs = () => {
    if (!lightboxThumbsContainer) return;
    lightboxThumbsContainer.innerHTML = images.map((image, index) => `
      <button
        class="lightbox-thumb flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-lg overflow-hidden opacity-40 hover:opacity-70 transition-all"
        data-index="${index}"
      >
        <img src="${image.url}" alt="${image.alt}" class="w-full h-full object-cover" loading="lazy"/>
      </button>
    `).join('');

    lightboxThumbs = Array.from(lightboxThumbsContainer.querySelectorAll('.lightbox-thumb'));
    lightboxThumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        currentIndex = parseInt(thumb.dataset.index);
        if (!images[currentIndex]) return;
        lightboxImage.src = images[currentIndex].url;
        lightboxImage.alt = images[currentIndex].alt;
        lightboxCounter.textContent = (currentIndex + 1).toString();
        updateActiveThumbs();
      });
    });
  };

  async function loadGallery() {
    try {
      const res = await fetch(`${apiUrl}/api/gallery?type=main`);
      if (!res.ok) throw new Error('Failed to fetch gallery');
      const data = await res.json();
      if (!Array.isArray(data) || data.length === 0) {
        if (statusEl) statusEl.textContent = 'Gallery unavailable.';
        return;
      }
      images = data
        .slice()
        .sort((a, b) => (a.position || 0) - (b.position || 0))
        .map((item, index) => ({
          id: item.id ?? index,
          url: toImageUrl(item.url),
          alt: item.alt || `BLVD Park Gallery ${index + 1}`,
        }));
      if (statusEl) statusEl.textContent = '';
      applyImages();
      renderLightboxThumbs();
    } catch (_error) {
      images = [];
      applyImages();
      renderLightboxThumbs();
      if (statusEl) statusEl.textContent = 'Gallery unavailable.';
    }
  }
  
  function openLightbox(index) {
    currentIndex = index;
    if (!images[index]) return;
    lightboxImage.src = images[index].url;
    lightboxImage.alt = images[index].alt;
    lightboxCounter.textContent = (index + 1).toString();
    updateActiveThumbs();
    lightbox.classList.remove('hidden');
    requestAnimationFrame(() => lightbox.classList.add('open'));
    document.body.style.overflow = 'hidden';
  }
  
  function closeLightbox() {
    lightbox.classList.remove('open');
    setTimeout(() => lightbox.classList.add('hidden'), 300);
    document.body.style.overflow = '';
  }
  
  function navigate(dir) {
    if (images.length === 0) return;
    currentIndex = (currentIndex + dir + images.length) % images.length;
    lightboxImage.src = images[currentIndex].url;
    lightboxImage.alt = images[currentIndex].alt;
    lightboxCounter.textContent = (currentIndex + 1).toString();
    updateActiveThumbs();
  }
  
  function updateActiveThumbs() {
    lightboxThumbs.forEach((t, i) => t.classList.toggle('active', i === currentIndex));
  }
  
  // Event listeners
  document.querySelectorAll('.gallery-thumb, .gallery-thumb-mobile').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(parseInt(btn.dataset.index)));
  });
  
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => navigate(-1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => navigate(1));
  
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
  
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox || e.target.classList.contains('lightbox-backdrop')) closeLightbox();
  });

  applyImages();
  loadGallery();
</script>
