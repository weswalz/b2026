---
// src/components/MenuSection2026.astro
// 2026 Redesign - Premium dark bento grid with hover reveals
---

<section id="menu" class="menu-2026 relative overflow-hidden bg-dark-gradient section-padding">

  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

  <!-- Ambient glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] opacity-20 bg-gradient-to-b from-blvd-green/40 to-transparent blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="menu-header text-center mb-12" style="opacity: 0; transform: translateY(30px);">
      <span class="eyebrow inline-block mb-4" data-cms-key="home.menu.eyebrow">Food & Cocktails</span>
      <h2
        class="font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-5 text-white tracking-tight"
        data-cms-key="home.menu.headline_html"
        data-cms-html="true"
      >
        Eat & Drink at <span class="text-blvd-green-bright">BLVD</span>
      </h2>
      <p class="max-w-xl mx-auto text-base md:text-lg text-white/50 font-body leading-relaxed" data-cms-key="home.menu.subtext">
        Chef-driven bites and craft cocktails. Perfect for pre-game fuel or post-match celebrations.
      </p>
    </div>

    <!-- Menu Buttons -->
    <div class="menu-buttons flex flex-wrap justify-center gap-4 mb-14" style="opacity: 0; transform: translateY(30px);">
      <a
        href="/menu"
        class="menu-btn-primary group inline-flex items-center gap-3 px-7 py-3.5 rounded-full font-display font-semibold text-sm bg-blvd-green text-white transition-all duration-300 hover:bg-blvd-green-bright hover:scale-105 hover:shadow-lg hover:shadow-blvd-green-bright/25"
        data-cms-attr="href:home.menu.cta_primary.href"
      >
        <span data-cms-key="home.menu.cta_primary.label">Main Menu</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a
        href="/menu/lunch"
        class="menu-btn-secondary group inline-flex items-center gap-3 px-7 py-3.5 rounded-full font-display font-semibold text-sm bg-white/[0.08] text-white border border-white/15 backdrop-blur-sm transition-all duration-300 hover:bg-white/15 hover:scale-105"
        data-cms-attr="href:home.menu.cta_secondary.href"
      >
        <span data-cms-key="home.menu.cta_secondary.label">Lunch Menu</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Bento Grid -->
    <div class="menu-grid grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4" style="opacity: 0; transform: translateY(30px);">

      <!-- Large Feature - Craft Cocktails (2x2) -->
      <div class="col-span-2 row-span-2 relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/drinks/drinks-craft.webp"
          alt="BLVD Craft Cocktails"
          data-cms-attr="src:home.menu.grid.0.image,alt:home.menu.grid.0.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity duration-500"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-blvd-green/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute bottom-5 left-5 right-5 md:bottom-7 md:left-7">
          <span class="eyebrow inline-block mb-2 text-[10px]" data-cms-key="home.menu.grid.0.eyebrow">Signature</span>
          <h3 class="font-display text-2xl md:text-3xl font-bold text-white" data-cms-key="home.menu.grid.0.label">Craft Cocktails</h3>
        </div>
      </div>

      <!-- Small Grid Items -->
      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/food/food-appetizer.webp"
          alt="BLVD Appetizers"
          data-cms-attr="src:home.menu.grid.1.image,alt:home.menu.grid.1.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.1.label">Starters</span>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/food/food-popular.webp"
          alt="BLVD Sliders"
          data-cms-attr="src:home.menu.grid.2.image,alt:home.menu.grid.2.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.2.label">Sliders</span>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/food/food-gourmet.webp"
          alt="BLVD Gourmet"
          data-cms-attr="src:home.menu.grid.3.image,alt:home.menu.grid.3.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.3.label">Tacos</span>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/drinks/drinks-beverage.webp"
          alt="BLVD Beverages"
          data-cms-attr="src:home.menu.grid.4.image,alt:home.menu.grid.4.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.4.label">Bloody Marys</span>
        </div>
      </div>

      <!-- Wide Feature - Burgers (2x1) -->
      <div class="col-span-2 relative group overflow-hidden rounded-2xl cursor-pointer aspect-[2/1]">
        <img
          src="/images/food/food-main-course.webp"
          alt="BLVD Signature Burgers"
          data-cms-attr="src:home.menu.grid.5.image,alt:home.menu.grid.5.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent transition-opacity duration-500"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-blvd-green/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <span class="eyebrow inline-block mb-1 text-[10px]" data-cms-key="home.menu.grid.5.eyebrow">Fan Favorite</span>
          <h3 class="font-display text-xl md:text-2xl font-bold text-white" data-cms-key="home.menu.grid.5.label">Signature Burgers</h3>
        </div>
      </div>

      <!-- More small items -->
      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/food/food-chef-special.webp"
          alt="Chef Specials"
          data-cms-attr="src:home.menu.grid.6.image,alt:home.menu.grid.6.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.6.label">Specials</span>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl cursor-pointer aspect-square">
        <img
          src="/images/drinks/drinks-cocktail.webp"
          alt="BLVD Cocktails"
          data-cms-attr="src:home.menu.grid.7.image,alt:home.menu.grid.7.alt"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
        <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
          <span class="font-display text-white text-sm font-semibold" data-cms-key="home.menu.grid.7.label">Mules</span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const menuObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const header = entry.target.querySelector('.menu-header');
          if (header) {
            header.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
            header.style.opacity = '1';
            header.style.transform = 'translateY(0)';
          }

          setTimeout(() => {
            const buttons = entry.target.querySelector('.menu-buttons');
            if (buttons) {
              buttons.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
              buttons.style.opacity = '1';
              buttons.style.transform = 'translateY(0)';
            }
          }, 150);

          setTimeout(() => {
            const grid = entry.target.querySelector('.menu-grid');
            if (grid) {
              grid.style.transition = 'all 0.8s cubic-bezier(0.19, 1, 0.22, 1)';
              grid.style.opacity = '1';
              grid.style.transform = 'translateY(0)';
            }
          }, 300);

          menuObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.menu-2026');
    if (section) menuObserver.observe(section);
  });
</script>
