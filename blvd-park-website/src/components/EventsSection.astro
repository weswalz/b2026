---
// src/components/EventsSection.astro - Events showcase section
// Displays upcoming and regular events in an accordion layout
import EventAccordion from './EventAccordion.astro';

// EDIT HERE: Event data with corresponding images
// To update events:
// 1. Add new event flyer images to /public/images/events/ directory
// 2. Update the events array below with new event information
// 3. The 'featured' property marks an event to display expanded by default
const events = [
  {
    id: 'event-1',
    title: 'Steak Night',
    date: 'Every Wednesday 6PM–11PM',
    flyerImage: '/images/events/steaknight2026.webp',
    featured: true,
    hidden: true,
    details: [
      '$22 Ribeye • $20 NY Strip',
      'Includes 2 sides',
      '$7 High Noon • $25 Seltzer Buckets',
      '$8 Casamigos',
      'Guest DJ',
      '<a href="/book" class="inline-block px-4 py-2 mt-2 bg-blvd-green text-blvd-white rounded-md hover:bg-blvd-dark-green transition-colors duration-300">Reserve Your Table</a>'
    ]
  },
  {
    id: 'event-2',
    title: 'Fiesta Bowl',
    date: 'Thurs Jan 8 • 6:30PM',
    flyerImage: '/images/events/fiesta.webp',
    featured: true,
    details: [
      'BLVD College Football Playoffs',
      'Watch Party',
      'Miami vs Ole Miss',
      'Free pickleball & volleyball • Game sounds',
      '$5 shots • $8 cocktails • $4 sliders • $1 boneless wings • $5 chips & queso',
      'Bucket specials: $25 domestic • $30 import • $35 seltzer',
      '<a href="/book" class="inline-block px-4 py-2 mt-2 bg-blvd-green text-blvd-white rounded-md hover:bg-blvd-dark-green transition-colors duration-300">Reserve Your Table</a>'
    ]
  }
];
---

<!-- Events section with BLVD Park brand green background -->
<section id="events" class="py-16 bg-blvd-green text-blvd-white">
  <div class="max-w-screen-xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">BLVD Events</h2>

    <!-- EventAccordion component renders the interactive event list -->
    <EventAccordion events={events} />
  </div>
</section>
