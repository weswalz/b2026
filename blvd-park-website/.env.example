# Frontend
PUBLIC_API_URL=http://localhost:3001
PUBLIC_TINYMCE_API_KEY=your-tinymce-api-key

# IndexNow key-file route (src/pages/[key].txt.ts) — server-side only, not PUBLIC_-prefixed.
# Must match backend/.env's INDEXNOW_KEY so the key file the ping references actually exists.
INDEXNOW_KEY=

# Cloudflare (optional - for cache purge on deploy)
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cloudflare-zone-id
